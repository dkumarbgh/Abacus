# Copy this file to .env and edit values there. .env is gitignored - your
# real secrets/settings never get committed. Anything left unset here just
# uses the default already built into the app.

# ---- Feature flags ----
# Set to false to turn a feature off completely (routes AND the UI entry
# points for it). Defaults to true (enabled) for everything if unset.
FEATURE_FACE_RECOGNITION=false
FEATURE_WHATSAPP=true
FEATURE_REFERRAL_PROGRAMME=true
FEATURE_STUDENT_IMPORT_EXPORT=true
FEATURE_EMAIL=true

# ---- Email (SMTP) ----
# Deployment-wide - used for sending practice sheets/test papers and any
# other email notifications. For Gmail: use an "App Password", NOT your
# regular password (Gmail blocks plain SMTP login with a normal password) -
# generate one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be turned on first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME=School Office
SMTP_FROM_EMAIL=youraddress@gmail.com

# ---- Database ----
# Where the SQLite file lives. On a host with an ephemeral filesystem
# (e.g. Render without a persistent Disk), point this at a mounted Disk
# path instead, or every deploy wipes your data.
DB_PATH=./school.db

# ---- Face recognition ----
# Where the Python face-service (face-service/app.py) is running.
FACE_SERVICE_URL=http://localhost:5001

# ---- Security ----
# Change these to random long strings in production - the defaults are
# only safe for local development.
SESSION_SECRET=change-this-secret-in-production
JWT_SECRET=change-this-secret-in-production
