<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2><%= exam.exam_name %> &mdash; Results (<%= exam.level_name %>)</h2>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Rank</th>
            <th>Student</th>
            <% subjects.forEach(s => { %>
                <th><%= s.subject_name %></th>
            <% }) %>
            <th>Total</th>
            <th>%</th>
        </tr>
    </thead>
    <tbody>
        <% if (rows.length === 0) { %>
            <tr><td colspan="<%= subjects.length + 4 %>" class="text-center">No marks entered for this exam yet</td></tr>
        <% } %>
        <% rows.forEach(r => { %>
            <tr class="<%= r.rank === 1 ? 'table-success' : '' %>">
                <td><%= r.rank %></td>
                <td><%= r.student_name %></td>
                <% subjects.forEach(s => { %>
                    <td><%= r.marks[s.id] !== undefined ? r.marks[s.id] : "-" %></td>
                <% }) %>
                <td><b><%= r.total %></b></td>
                <td><%= r.percentage %>%</td>
            </tr>
        <% }) %>
    </tbody>
</table>

<a href="/exams" class="btn btn-link">&larr; Back to Exams</a>

<%- include("partials/footer") %>
