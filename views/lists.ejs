<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>Courses, Batches, Levels & Branches</h2>
<p class="text-muted">These lists power the dropdowns on the Student registration form.</p>

<div class="row">
    <% Object.keys(listTypes).forEach(function(type) { %>
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><%= listTypes[type] %></h5>
                </div>
                <div class="card-body">

                    <form action="/lists/add" method="POST" class="d-flex gap-2 mb-3">
                        <input type="hidden" name="list_type" value="<%= type %>">
                        <input type="text" name="name" class="form-control" placeholder="Add new <%= listTypes[type].toLowerCase() %> entry" required>
                        <button class="btn btn-success">Add</button>
                    </form>

                    <% if (grouped[type].length === 0) { %>
                        <p class="text-muted small">No entries yet.</p>
                    <% } else { %>
                        <ul class="list-group">
                            <% grouped[type].forEach(function(item) { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <%= item.name %>
                                    <a href="/lists/delete/<%= item.id %>"
                                       class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Delete &quot;<%= item.name %>&quot;? Students already using it will just show it as unset.')">
                                        Delete
                                    </a>
                                </li>
                            <% }) %>
                        </ul>
                    <% } %>

                </div>
            </div>
        </div>
    <% }) %>
</div>

<%- include("partials/footer") %>
