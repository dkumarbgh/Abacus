<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>WhatsApp Messages</h2>

<p>
    Connection status:
    <% if (ready) { %>
        <span class="badge bg-success">Connected</span>
    <% } else { %>
        <span class="badge bg-danger">Not Connected</span>
    <% } %>
    &nbsp;<a href="/whatsapp/debug" class="small">🔧 Full diagnostics</a>
</p>

<% if (!ready) { %>
<div class="card shadow mb-4">
    <div class="card-header bg-warning"><h5 class="mb-0">Connect WhatsApp to Start Messaging</h5></div>
    <div class="card-body text-center">
        <% if (qrImage) { %>
            <p>Open WhatsApp on your phone &rarr; Settings &gt; Linked Devices &gt; Link a Device, then scan:</p>
            <img id="whatsappQrImg" src="<%= qrImage %>" alt="WhatsApp QR code" style="max-width:260px">
            <p class="small text-muted mt-2">
                This code refreshes itself automatically every few seconds, so it should always be scannable -
                no need to reload the page while lining up your phone.
            </p>
        <% } else if (diagnostics.chromeExists === false) { %>
            <p class="text-danger mb-1"><strong>Can't start yet - Chrome isn't available on this server.</strong></p>
            <p class="small text-muted">See <a href="/whatsapp/debug">Full diagnostics</a> for what to fix.</p>
        <% } else { %>
            <p class="text-muted" id="whatsappStartingMsg">Starting up - this will pick up the QR code automatically once it's ready.</p>
        <% } %>
        <button class="btn btn-outline-secondary btn-sm mt-2" onclick="location.reload()">🔄 Refresh</button>
    </div>
</div>
<script>
// Keeps the QR code (and the "connected" state) live without the visitor
// needing to manually reload at just the right moment - see the comment on
// GET /whatsapp/status for why a static QR image is the real cause behind
// most "could not link the device" reports.
(function () {
    let stopped = false;
    async function poll() {
        if (stopped) return;
        try {
            const res = await fetch('/whatsapp/status');
            const data = await res.json();
            if (data.ready) {
                stopped = true;
                location.reload(); // show the fully-connected page
                return;
            }
            const img = document.getElementById('whatsappQrImg');
            if (data.qrImage && img && img.src !== data.qrImage) {
                img.src = data.qrImage;
            } else if (data.qrImage && !img) {
                // QR just became available where there was none before (e.g.
                // Chrome finished starting up) - reload once to render it.
                stopped = true;
                location.reload();
                return;
            }
        } catch (e) {
            // Transient fetch failure - just try again on the next tick.
        }
        setTimeout(poll, 4000);
    }
    poll();
})();
</script>
<% } %>

<div class="row">

    <div class="col-md-6">
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white"><h5>Message a Guardian</h5></div>
            <div class="card-body">
                <form action="/whatsapp/send" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Student</label>
                        <select name="student_id" class="form-select" required>
                            <option value="">Select student</option>
                            <% students.forEach(s => { %>
                                <option value="<%= s.id %>">
                                    <%= s.name %> (<%= s.class_name || "-" %>) &mdash;
                                    <%= [s.guardian_phone, s.guardian_phone_2].filter(Boolean).join(" / ") || "no phone on file" %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea name="message" class="form-control" rows="4" required></textarea>
                    </div>
                    <button class="btn btn-success w-100">Send</button>
                </form>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-header bg-secondary text-white"><h5>Broadcast to a Class</h5></div>
            <div class="card-body">
                <form action="/whatsapp/broadcast" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Class</label>
                        <select name="class_id" class="form-select" required>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.class_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea name="message" class="form-control" rows="4" required></textarea>
                    </div>
                    <button class="btn btn-warning w-100">Broadcast to Class</button>
                    <small class="text-muted d-block mt-2">Sends one-by-one with a short delay between messages.</small>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white"><h5>Recent Message Log</h5></div>
            <div class="card-body" style="max-height: 600px; overflow-y:auto;">
                <table class="table table-bordered table-sm">
                    <thead class="table-dark">
                        <tr><th>Time</th><th>Student</th><th>Type</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <% if (logs.length === 0) { %>
                            <tr><td colspan="4" class="text-center">No messages sent yet</td></tr>
                        <% } %>
                        <% logs.forEach(l => { %>
                            <tr>
                                <td><%= new Date(l.sent_at).toLocaleString() %></td>
                                <td><%= l.student_name || l.phone %></td>
                                <td><%= l.type %></td>
                                <td>
                                    <% if (l.status === 'SENT') { %>
                                        <span class="badge bg-success">Sent</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Failed</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<%- include("partials/footer") %>
