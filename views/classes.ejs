<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Classes</h2>
    <a href="/classes/add" class="btn btn-success">➕ Add Class</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Class Name</th>
            <th>Status</th>
            <th width="280">Action</th>
        </tr>
    </thead>
    <tbody>
        <% if (classes.length === 0) { %>
            <tr><td colspan="3" class="text-center">No classes yet.</td></tr>
        <% } %>
        <% classes.forEach(c => { %>
            <tr class="<%= c.is_active ? '' : 'table-secondary' %>">
                <td><%= c.class_name %></td>
                <td>
                    <% if (c.is_active) { %>
                        <span class="badge bg-success">Active</span>
                    <% } else { %>
                        <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                </td>
                <td>
                    <a href="/classes/edit/<%= c.id %>" class="btn btn-primary btn-sm">Edit</a>

                    <form action="/classes/toggle/<%= c.id %>" method="POST" class="d-inline">
                        <button class="btn btn-sm <%= c.is_active ? 'btn-outline-secondary' : 'btn-outline-success' %>" type="submit">
                            <%= c.is_active ? 'Mark Inactive' : 'Mark Active' %>
                        </button>
                    </form>

                    <a href="/classes/delete/<%= c.id %>" class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this class? Students already assigned to it will keep their reference, but you won\'t be able to pick it for anyone new.')">
                        Delete
                    </a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include("partials/footer") %>
