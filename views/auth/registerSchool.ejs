<%- include("../partials/header") %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="text-center mb-4">Register Your School</h3>

                    <% if (error) { %>
                        <div class="alert alert-danger"><%= error %></div>
                    <% } %>

                    <form method="POST" action="/register-school">

                        <h6 class="text-muted">School Details</h6>
                        <div class="mb-3">
                            <label class="form-label">School Name</label>
                            <input type="text" name="school_name" class="form-control" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phone</label>
                                <input type="text" name="school_phone" class="form-control">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="school_email" class="form-control">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <input type="text" name="school_address" class="form-control">
                        </div>

                        <hr>
                        <h6 class="text-muted">Your Admin Login</h6>
                        <div class="mb-3">
                            <label class="form-label">Your Name</label>
                            <input type="text" name="admin_name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Your Email (used to log in)</label>
                            <input type="email" name="admin_email" class="form-control" required>
                        </div>
                        <%- include("../partials/passwordField", { id: "regPassword", name: "admin_password", label: "Password", required: true, minlength: 6 }) %>

                        <button class="btn btn-success w-100">Create School & Log In</button>
                    </form>

                    <hr>
                    <p class="text-center mb-0">
                        Already have a school registered? <a href="/login">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>
