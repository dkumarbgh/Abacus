<%- include("../partials/header") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="text-center mb-4">🏫 Abacas Kuvempunagar</h3>

                    <% if (error) { %>
                        <div class="alert alert-danger"><%= error %></div>
                    <% } %>

                    <form method="POST" action="/login">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control" value="<%= email %>" required autofocus>
                        </div>
                        <%- include("../partials/passwordField", { id: "loginPassword", name: "password", label: "Password", required: true }) %>
                        <button class="btn btn-primary w-100">Log In</button>
                    </form>

                    <hr>
                    <p class="text-center mb-0">
                        New school? <a href="/register-school">Register your school</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>
