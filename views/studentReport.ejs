<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h2>Student Report</h2>
    <div>
        <a href="/level-promotion?student_id=<%= student.id %>" class="btn btn-outline-primary">🎓 Promote Level</a>
        <a href="/certificates/generate/<%= student.id %>" class="btn btn-outline-primary" target="_blank">📜 Generate Certificate</a>
        <button class="btn btn-outline-secondary" onclick="window.print()">🖨 Print</button>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-body d-flex align-items-center gap-3">
        <% if (student.photo_path) { %>
            <img src="<%= student.photo_path %>" width="80" height="80" style="object-fit:cover" class="rounded-circle border">
        <% } %>
        <div>
            <h4 class="mb-1"><%= student.name %></h4>
            <div class="text-muted">
                <%= student.class_name || "Not Assigned" %> &middot;
                Roll Number: <%= student.admission_no || "-" %> &middot;
                Age: <%= student.age %>
            </div>
            <div class="text-muted">Guardian: <%= student.guardian_name || "-" %> (<%= student.guardian_phone || "-" %>)</div>
            <% if (student.date_of_joining) { %>
                <div class="text-muted small">Joined: <%= student.date_of_joining %></div>
            <% } %>
            <% if (student.remarks) { %>
                <div class="text-muted small"><strong>Remarks:</strong> <%= student.remarks %></div>
            <% } %>
        </div>
    </div>
</div>

<% if (feeSchedule.length > 0) { %>
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">📅 Payment Schedule Summary</h5>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Each fee that's split into periods (Monthly, Bimonthly, Quarterly, Half-Yearly, or an
            auto-assigned Fee Plan), at a glance. See Payment History below for exact payment dates.
        </p>
        <div class="row g-3 mb-3">
            <% feeSchedule.forEach(function(sched) { %>
                <div class="col-md-6">
                    <div class="border rounded p-2 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong><%= sched.fee_name %></strong>
                            <span class="badge <%= sched.paidCount === sched.totalCount ? 'bg-success' : (sched.paidCount > 0 ? 'bg-warning text-dark' : 'bg-danger') %>">
                                <%= sched.paidCount %> / <%= sched.totalCount %> paid
                            </span>
                        </div>
                        <% if (!simpleFeeMode) { %>
                            <div class="small text-muted mb-2">₹<%= sched.totalPaid %> paid of ₹<%= sched.totalAmount %> total</div>
                        <% } %>
                        <% if (sched.nextDue) { %>
                            <div class="small">
                                <span class="text-danger">Next due:</span> <%= sched.nextDue.installment_label %>
                                <% if (!simpleFeeMode) { %>(₹<%= sched.nextDue.due %>)<% } %>
                            </div>
                        <% } else { %>
                            <div class="small text-success">All periods paid ✓</div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>
<% } %>

<div class="row">

    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-primary text-white"><h5>Attendance</h5></div>
            <div class="card-body">
                <p>Present Days (all-time): <b><%= attSummary.present_days || 0 %></b> / <%= attSummary.total_marked || 0 %> marked</p>
                <p>Overall Attendance %:
                    <% if (attendancePct !== "N/A" && attendancePct < 75) { %>
                        <span class="badge bg-danger"><%= attendancePct %>%</span>
                    <% } else if (attendancePct === "N/A") { %>
                        <span class="text-muted">N/A</span>
                    <% } else { %>
                        <span class="badge bg-success"><%= attendancePct %>%</span>
                    <% } %>
                </p>

                <% if (student.batch_name) { %>
                    <p class="small text-muted mb-1">
                        Batch: <%= student.batch_name %><%= student.sessions_per_week ? ' (' + student.sessions_per_week + ' sessions/week)' : '' %>
                    </p>
                <% } %>

                <hr>
                <h6 class="small text-muted">Monthly Regularity (last 6 months)</h6>
                <% if (!student.sessions_per_week) { %>
                    <p class="small text-muted">No batch schedule set - can't calculate expected classes per month.</p>
                <% } else { %>
                    <table class="table table-sm table-bordered mb-0">
                        <thead><tr><th>Month</th><th>Attended</th><th>Expected</th><th>%</th><th>Status</th></tr></thead>
                        <tbody>
                            <% monthlyRegularity.forEach(function(m) { %>
                                <tr>
                                    <td><%= m.month %></td>
                                    <td><%= m.attended %></td>
                                    <td><%= m.expected == null ? '-' : m.expected %></td>
                                    <td><%= m.pct == null ? '-' : m.pct + '%' %></td>
                                    <td>
                                        <% if (m.status === 'Regular') { %>
                                            <span class="badge bg-success">Regular</span>
                                        <% } else if (m.status === 'Irregular') { %>
                                            <span class="badge bg-danger">Irregular</span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-warning d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Fee Status</h5>
                <% if (simpleFeeMode) { %><span class="badge bg-dark">Paid / Not Paid</span><% } %>
            </div>
            <div class="card-body">
                <% if (simpleFeeMode) { %>
                    <p>
                        <% var allPaid = feeInfo.feeItems.length > 0 && feeInfo.feeItems.every(f => f.due <= 0); %>
                        <% if (feeInfo.feeItems.length === 0) { %>
                            <span class="text-muted">No fee structure for this class</span>
                        <% } else if (allPaid) { %>
                            <span class="badge bg-success">All fees paid</span>
                        <% } else { %>
                            <span class="badge bg-danger">Fees pending</span>
                        <% } %>
                    </p>
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>Fee</th><th>Status</th></tr></thead>
                        <tbody>
                            <% if (feeInfo.feeItems.length === 0) { %>
                                <tr><td colspan="2" class="text-center">No fee structure for this class</td></tr>
                            <% } %>
                            <% feeInfo.feeItems.forEach(f => { %>
                                <tr class="<%= f.due > 0 ? 'table-warning' : '' %>">
                                    <td><%= f.fee_name %><%= f.installment_label ? ' - ' + f.installment_label : '' %></td>
                                    <td>
                                        <% if (f.due > 0) { %>
                                            <span class="badge bg-danger">Not Paid</span>
                                        <% } else { %>
                                            <span class="badge bg-success">Paid</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p>Total Outstanding: <b>₹<%= feeInfo.totalDue %></b></p>
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>Fee</th><th>Amount</th><th>Discount</th><th>Paid</th><th>Due</th><th>Due Date</th><th>Paid Date</th></tr></thead>
                        <tbody>
                            <% if (feeInfo.feeItems.length === 0) { %>
                                <tr><td colspan="7" class="text-center">No fee structure for this class</td></tr>
                            <% } %>
                            <% feeInfo.feeItems.forEach(f => { %>
                                <tr class="<%= f.due > 0 ? 'table-warning' : '' %>">
                                    <td><%= f.fee_name %><%= f.installment_label ? ' - ' + f.installment_label : '' %></td>
                                    <td>₹<%= f.amount %></td>
                                    <td>
                                        <% if (f.discount) { %>
                                            <% if (f.discount.discount_type === 'PERCENT') { %>
                                                <%= f.discount.discount_value %>%
                                            <% } else { %>
                                                ₹<%= f.discount.discount_value %>
                                            <% } %>
                                        <% } else { %>
                                            &mdash;
                                        <% } %>
                                    </td>
                                    <td>₹<%= f.paid %></td>
                                    <td>₹<%= f.due %></td>
                                    <td>
                                        <% if (f.due_date) { %>
                                            <%= f.due_date %><% if (f.due > 0 && f.due_date < today) { %> <span class="badge bg-danger">Overdue</span><% } %>
                                        <% } else { %>
                                            &mdash;
                                        <% } %>
                                    </td>
                                    <td><% if (f.paidDate) { %><%= f.paidDate %><% } else { %>&mdash;<% } %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Payment History</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th><th>Fee</th>
                            <% if (!simpleFeeMode) { %><th>Amount</th><% } %>
                            <th>Mode</th><th>Receipt No.</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (paymentHistory.length === 0) { %>
                            <tr><td colspan="<%= simpleFeeMode ? 5 : 6 %>" class="text-center">No payments recorded yet</td></tr>
                        <% } %>
                        <% paymentHistory.forEach(p => { %>
                            <tr>
                                <td><%= p.payment_date %></td>
                                <td><%= p.fee_name %><%= p.installment_label ? ' - ' + p.installment_label : '' %></td>
                                <% if (!simpleFeeMode) { %><td>₹<%= p.amount_paid %></td><% } %>
                                <td><%= p.mode %></td>
                                <td><%= p.receipt_no %></td>
                                <td><a href="/reports/receipt/<%= p.id %>" class="btn btn-outline-primary btn-sm no-print" target="_blank">🧾</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<div class="card shadow mb-4">
    <div class="card-header bg-success text-white"><h5>Exam History</h5></div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr><th>Exam</th><th>Date</th><th>Subject</th><th>Marks</th></tr>
            </thead>
            <tbody>
                <% if (examResults.length === 0) { %>
                    <tr><td colspan="4" class="text-center">No exam records yet</td></tr>
                <% } %>
                <% examResults.forEach(e => { %>
                    <tr>
                        <td><%= e.exam_name %></td>
                        <td><%= e.exam_date || "-" %></td>
                        <td><%= e.subject_name %></td>
                        <td><%= e.marks_obtained %> / <%= e.max_marks %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<a href="/students" class="btn btn-link no-print">&larr; Back to Students</a>

<style>
    @media print {
        .no-print, nav, .navbar { display: none !important; }
    }
</style>

<%- include("partials/footer") %>
