<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2 class="mb-4">
    Dashboard
</h2>

<div class="row">

    <div class="col-md-4">
        <div class="card shadow text-center">
            <div class="card-body">
                <h5>👨‍🎓 Students</h5>
                <h1><%= students %></h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow text-center">
            <div class="card-body">
                <h5>🏫 Classes</h5>
                <h1><%= classes %></h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow text-center">
            <div class="card-body">
                <h5>👨‍🏫 Teachers</h5>
                <h1><%= teachers %></h1>
            </div>
        </div>
    </div>

</div>

<div class="row mt-4">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">
                Recent Students
            </div>

            <div class="card-body">

                <table class="table">

                    <tr>
                        <th>Name</th>
                        <th>Class</th>
                    </tr>

                    <% recentStudents.forEach(student => { %>

                    <tr>

                        <td><%= student.name %></td>

                        <td><%= student.class_name || "Not Assigned" %></td>

                    </tr>

                    <% }) %>

                </table>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-success text-white">
                Students by Class
            </div>

            <div class="card-body">

                <table class="table">

                    <tr>
                        <th>Class</th>
                        <th>Total</th>
                    </tr>

                    <% classSummary.forEach(item => { %>

                    <tr>

                        <td><%= item.class_name %></td>

                        <td><%= item.total %></td>

                    </tr>

                    <% }) %>

                </table>

            </div>

        </div>

    </div>

</div>

<%- include("partials/footer") %>