<div class="mb-3">
    <% if (typeof label !== 'undefined' && label) { %><label class="form-label"><%= label %></label><% } %>
    <div class="input-group">
        <input
            type="password"
            id="<%= id %>"
            name="<%= name %>"
            class="form-control"
            <% if (typeof placeholder !== 'undefined' && placeholder) { %>placeholder="<%= placeholder %>"<% } %>
            <% if (typeof required !== 'undefined' && required) { %>required<% } %>
            <% if (typeof minlength !== 'undefined' && minlength) { %>minlength="<%= minlength %>"<% } %>
            value="<%= typeof value !== 'undefined' ? value : '' %>">
        <button type="button" class="btn btn-outline-secondary toggle-password" data-target="<%= id %>" tabindex="-1">
            <i class="bi bi-eye"></i>
        </button>
    </div>
    <% if (typeof help !== 'undefined' && help) { %><small class="text-muted"><%= help %></small><% } %>
</div>
