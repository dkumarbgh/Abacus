<%#
  Branch checkboxes for Add/Edit User forms (label only - doesn't restrict access).
  Params: idPrefix (unique per form), selectedIds (array of branch ids, optional),
          manageHint (optional text shown when the school has no branches yet).
  Reads schoolBranches from res.locals (services/userBranches.loadBranchLocals).
%>
<% const _branches = (typeof schoolBranches !== 'undefined' && schoolBranches) ? schoolBranches : []; %>
<% const _selected = (typeof selectedIds !== 'undefined' && selectedIds ? selectedIds : []).map(Number); %>
<div class="mb-3" data-testid="branch-picker">
    <label class="form-label">Branch(es)</label>
    <% if (_branches.length === 0) { %>
        <div class="form-text"><%= (typeof manageHint !== 'undefined' && manageHint) ? manageHint : "No branches set up for this school yet." %></div>
    <% } else { %>
        <div class="border rounded p-2" style="max-height: 160px; overflow-y: auto;">
            <% _branches.forEach(b => { %>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="branch_ids" value="<%= b.id %>"
                           id="<%= idPrefix %>Branch<%= b.id %>" <%= _selected.includes(Number(b.id)) ? 'checked' : '' %>>
                    <label class="form-check-label" for="<%= idPrefix %>Branch<%= b.id %>"><%= b.name %></label>
                </div>
            <% }) %>
        </div>
        <div class="form-text">Tick every branch this person works at. (For information only for now.)</div>
    <% } %>
</div>
