</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
// Wires up any password field built with the toggle-password markup (see
// partials/passwordField.ejs) to show/hide its value via the eye icon.
// Global here (not per-page) so it works automatically on every password
// field across the app without repeating this script everywhere.
document.querySelectorAll('.toggle-password').forEach(function (btn) {
    btn.addEventListener('click', function () {
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        const icon = btn.querySelector('i');
        if (icon) icon.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
    });
});
</script>

<% if (typeof readOnly !== 'undefined' && readOnly) { %>
<script>
// View-only (demo) login: grey out everything that would change data, so a
// visitor isn't left clicking Save and wondering why nothing happened. This
// is only the friendly layer - the server refuses these requests anyway
// (see middleware/readOnly.js). Search/filter forms (method GET) and
// report links stay fully usable.
(function () {
    var TIP = 'View-only demo - changes are not saved';
    document.querySelectorAll('form').forEach(function (form) {
        var method = (form.getAttribute('method') || 'GET').toUpperCase();
        var action = form.getAttribute('action') || '';
        if (method === 'GET' || /\/logout$/.test(action)) return;
        form.querySelectorAll('button, input[type=submit], input[type=image]').forEach(function (btn) {
            btn.disabled = true;
            btn.title = TIP;
            btn.classList.add('opacity-50');
        });
        form.addEventListener('submit', function (e) { e.preventDefault(); alert(TIP); });
    });
    var blocked = [/\/delete(\/|-|$)/i, /\/remove(\/|$)/i, /\/assign-missing/i, /\/settings\/backup/, /^\/users(\/|$)/, /^\/whatsapp/];
    document.querySelectorAll('a[href]').forEach(function (a) {
        var path;
        try { path = new URL(a.href, location.href).pathname; } catch (e) { return; }
        if (blocked.some(function (rx) { return rx.test(path); })) {
            a.classList.add('disabled', 'opacity-50');
            a.setAttribute('aria-disabled', 'true');
            a.title = TIP;
            a.removeAttribute('onclick');
            a.addEventListener('click', function (e) { e.preventDefault(); });
        }
    });
})();
</script>
<% } %>

</body>

</html>