<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>⚠ Inactive Students</h2>
<p class="text-muted">
    Students who haven't attended any class in a while - a follow-up list to catch someone drifting
    away before they formally drop out. Includes new admissions who've never attended too.
</p>

<form method="GET" action="/reports/inactive-students" class="row g-2 mb-4">
    <div class="col-md-2">
        <label class="form-label small mb-0">Inactive For</label>
        <select name="days" class="form-select">
            <% [7,14,30,60,90].forEach(function(n) { %>
                <option value="<%= n %>" <%= days===n ? "selected" : "" %>><%= n %>+ days</option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0">Class</label>
        <select name="class_id" class="form-select">
            <option value="">All Classes</option>
            <% classes.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= String(classId)===String(c.id) ? "selected" : "" %>><%= c.class_name %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0">Batch</label>
        <select name="batch_id" class="form-select">
            <option value="">All Batches</option>
            <% batches.forEach(function(b) { %>
                <option value="<%= b.id %>" <%= String(batchId)===String(b.id) ? "selected" : "" %>><%= b.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0">Level</label>
        <select name="level_id" class="form-select">
            <option value="">All Levels</option>
            <% levels.forEach(function(l) { %>
                <option value="<%= l.id %>" <%= String(levelId)===String(l.id) ? "selected" : "" %>><%= l.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0">Branch/Centre</label>
        <select name="branch_id" class="form-select">
            <option value="">All Branches</option>
            <% branches.forEach(function(b) { %>
                <option value="<%= b.id %>" <%= String(branchId)===String(b.id) ? "selected" : "" %>><%= b.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0">Student Name / Roll No.</label>
        <input type="text" name="student_name" class="form-control" placeholder="Search..." value="<%= studentName %>">
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button class="btn btn-primary w-100">Go</button>
    </div>
</form>

<% if (students.length === 0) { %>
    <div class="alert alert-success">No inactive students found for these filters - everyone's attending regularly. 🎉</div>
<% } else { %>

<form action="/reports/inactive-students/follow-up" method="POST" id="followUpForm">
    <input type="hidden" name="class_id" value="<%= classId %>">
    <input type="hidden" name="batch_id" value="<%= batchId %>">
    <input type="hidden" name="level_id" value="<%= levelId %>">
    <input type="hidden" name="branch_id" value="<%= branchId %>">
    <input type="hidden" name="student_name" value="<%= studentName %>">
    <input type="hidden" name="days" value="<%= days %>">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <button type="button" id="selectAllBtn" class="btn btn-sm btn-outline-secondary">Select All</button>
            <button type="button" id="clearAllBtn" class="btn btn-sm btn-outline-secondary">Clear All</button>
        </div>
        <button class="btn btn-warning" onclick="return confirm('Send a WhatsApp follow-up message to guardians of all selected students?')">
            💬 Send Follow-up to Selected
        </button>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th width="40"></th>
                <th>Student</th>
                <th>Class</th>
                <th>Batch</th>
                <th>Level</th>
                <th>Branch/Centre</th>
                <th>Last Attended</th>
                <th>Days Since</th>
                <th>WhatsApp 1 Number</th>
            </tr>
        </thead>
        <tbody>
            <% students.forEach(function(s) { %>
                <tr class="<%= s.last_attended === null ? 'table-danger' : '' %>">
                    <td class="text-center">
                        <input type="checkbox" name="student_ids" value="<%= s.id %>" <%= s.guardian_phone ? "" : "disabled" %>>
                    </td>
                    <td><a href="/reports/student/<%= s.id %>"><%= s.name %></a><%= s.admission_no ? ' (' + s.admission_no + ')' : '' %></td>
                    <td><%= s.class_name || '-' %></td>
                    <td><%= s.batch_name || '-' %></td>
                    <td><%= s.level_name || '-' %></td>
                    <td><%= s.branch_name || '-' %></td>
                    <td>
                        <% if (s.last_attended === null) { %>
                            <span class="badge bg-danger">Never attended</span>
                        <% } else { %>
                            <%= s.last_attended %>
                        <% } %>
                    </td>
                    <td>
                        <% if (s.daysSince !== null) { %>
                            <span class="badge bg-secondary"><%= s.daysSince %> days</span>
                        <% } else { %>
                            -
                        <% } %>
                    </td>
                    <td>
                        <% if (s.guardian_phone) { %>📞 <%= s.guardian_phone %><br><% } %>
                        <% if (s.guardian_email) { %>✉ <%= s.guardian_email %><% } %>
                        <% if (!s.guardian_phone && !s.guardian_email) { %><span class="text-muted small">No contact info on file</span><% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</form>

<% } %>

<a href="/reports" class="btn btn-link">&larr; Back to Reports</a>

<script>
document.getElementById('selectAllBtn') && document.getElementById('selectAllBtn').addEventListener('click', () => {
    document.querySelectorAll('input[name="student_ids"]:not(:disabled)').forEach(cb => cb.checked = true);
});
document.getElementById('clearAllBtn') && document.getElementById('clearAllBtn').addEventListener('click', () => {
    document.querySelectorAll('input[name="student_ids"]').forEach(cb => cb.checked = false);
});
</script>

<%- include("partials/footer") %>
