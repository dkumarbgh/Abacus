<%- include("partials/header") %>
<%- include("partials/navbar") %>

<a href="/practice-sheets" class="btn btn-outline-secondary btn-sm mb-3">&larr; Practice Sheets</a>

<h2>Send: <%= sheet.title %></h2>
<p class="text-muted"><%= sheet.class_name %> &middot; <%= sheet.subject_name %></p>

<form action="/practice-sheets/<%= sheet.id %>/send" method="POST" id="sendForm">

    <div class="card shadow mb-3">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <span>Select Students</span>
            <span>
                <button type="button" id="selectAllBtn" class="btn btn-sm btn-outline-light">Select All</button>
                <button type="button" id="clearAllBtn" class="btn btn-sm btn-outline-light">Clear All</button>
            </span>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label small mb-0">Filter by Class</label>
                    <select id="classFilter" class="form-select">
                        <option value="">All Classes</option>
                        <% classes.forEach(function(c) { %>
                            <option value="<%= c.id %>"><%= c.class_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-0">Filter by Batch</label>
                    <select id="batchFilter" class="form-select">
                        <option value="">All Batches</option>
                        <% batches.forEach(function(b) { %>
                            <option value="<%= b.id %>"><%= b.name %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div id="studentListArea" style="max-height:300px; overflow-y:auto;" class="mb-3">
                <p class="text-muted">Choose a filter above to load students.</p>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <div class="form-check">
                        <input type="checkbox" name="via_whatsapp" class="form-check-input" id="viaWhatsapp">
                        <label class="form-check-label" for="viaWhatsapp">Send via WhatsApp</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <input type="checkbox" name="via_email" class="form-check-input" id="viaEmail" <%= emailConfigured ? "" : "disabled" %>>
                        <label class="form-check-label" for="viaEmail">
                            Send via Email
                            <% if (!emailConfigured) { %>
                                <span class="text-muted">(not configured - see .env.example)</span>
                            <% } %>
                        </label>
                    </div>
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label small mb-0">Message / Caption</label>
                <input type="text" name="caption" class="form-control" placeholder="Please find attached: <%= sheet.title %>">
            </div>
            <div class="mb-3">
                <label class="form-label small mb-0">Email Subject (if sending via Email)</label>
                <input type="text" name="subject" class="form-control" value="<%= sheet.title %>">
            </div>

            <button type="button" id="sendBtn" class="btn btn-success">📤 Send</button>
        </div>
    </div>

</form>

<script>
async function loadStudents() {
    const classId = document.getElementById('classFilter').value;
    const batchId = document.getElementById('batchFilter').value;
    const area = document.getElementById('studentListArea');

    const params = new URLSearchParams();
    if (classId) params.set('class_id', classId);
    if (batchId) params.set('batch_id', batchId);

    const res = await fetch('/practice-sheets/<%= sheet.id %>/students?' + params.toString());
    const data = await res.json();
    if (!data.ok) { area.innerHTML = '<p class="text-danger">Could not load students.</p>'; return; }
    if (data.students.length === 0) { area.innerHTML = '<p class="text-muted">No students match this filter.</p>'; return; }

    area.innerHTML = data.students.map(s => `
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="${s.id}" id="stu_${s.id}" data-student-checkbox>
            <label class="form-check-label" for="stu_${s.id}">
                ${s.name}${s.admission_no ? ' (' + s.admission_no + ')' : ''}
                ${!s.guardian_phone ? ' <span class="text-muted small">[no phone]</span>' : ''}
                ${!s.guardian_email ? ' <span class="text-muted small">[no email]</span>' : ''}
            </label>
        </div>
    `).join('');
}

document.getElementById('classFilter').addEventListener('change', loadStudents);
document.getElementById('batchFilter').addEventListener('change', loadStudents);

document.getElementById('selectAllBtn').addEventListener('click', () => {
    document.querySelectorAll('[data-student-checkbox]').forEach(cb => cb.checked = true);
});
document.getElementById('clearAllBtn').addEventListener('click', () => {
    document.querySelectorAll('[data-student-checkbox]').forEach(cb => cb.checked = false);
});

document.getElementById('sendBtn').addEventListener('click', () => {
    const form = document.getElementById('sendForm');
    const selectedIds = Array.from(document.querySelectorAll('[data-student-checkbox]:checked')).map(cb => cb.value);
    if (selectedIds.length === 0) { alert('Please select at least one student.'); return; }

    selectedIds.forEach(id => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'student_ids';
        input.value = id;
        form.appendChild(input);
    });

    form.submit();
});
</script>

<%- include("partials/footer") %>
