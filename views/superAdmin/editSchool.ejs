<%- include("../partials/header") %>
<%- include("../partials/superAdminNav") %>

<a href="/super-admin/schools/<%= school.id %>" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to School</a>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4>Edit School Details</h4>
            </div>
            <div class="card-body">

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/super-admin/schools/<%= school.id %>/edit" method="POST">
                    <div class="mb-3">
                        <label class="form-label">School Name</label>
                        <input type="text" name="name" class="form-control" value="<%= school.name %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" name="address" class="form-control" value="<%= school.address || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" class="form-control" value="<%= school.phone || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="<%= school.email || '' %>">
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="sfm" name="simple_fee_mode" <%= school.simple_fee_mode ? "checked" : "" %>>
                        <label class="form-check-label" for="sfm">Simple Fee Mode</label>
                    </div>
                    <button class="btn btn-primary">Save Changes</button>
                    <a href="/super-admin/schools/<%= school.id %>" class="btn btn-secondary">Cancel</a>
                </form>

            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>
