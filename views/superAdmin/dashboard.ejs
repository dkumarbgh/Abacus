<%- include("../partials/header") %>
<%- include("../partials/superAdminNav") %>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2>All Registered Schools</h2>
    <a href="/super-admin/schools/new" class="btn btn-success">➕ Create New School</a>
</div>
<p class="text-muted">Every school registered on this deployment, with its user and student counts.</p>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>School</th>
            <th>Contact</th>
            <th>Registered</th>
            <th>Users</th>
            <th>Students</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% if (schools.length === 0) { %>
            <tr><td colspan="6" class="text-center">No schools registered yet.</td></tr>
        <% } %>
        <% schools.forEach(function(s) { %>
            <tr>
                <td><strong><%= s.name %></strong></td>
                <td>
                    <%= s.email || "-" %><br>
                    <span class="text-muted small"><%= s.phone || "" %></span>
                </td>
                <td><%= s.created_at %></td>
                <td><span class="badge bg-primary"><%= s.user_count %></span></td>
                <td><span class="badge bg-success"><%= s.student_count %></span></td>
                <td>
                    <a href="/super-admin/schools/<%= s.id %>" class="btn btn-primary btn-sm">Manage</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include("../partials/footer") %>
