<%- include("../partials/header") %>
<%- include("../partials/superAdminNav") %>

<a href="/super-admin" class="btn btn-outline-secondary btn-sm mb-3">&larr; All Schools</a>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Roles &amp; Capabilities</h2>
        <p class="text-muted mb-0">Choose which modules each role can open. A user's Primary Role and any
            Additional Roles (set from School Detail, User Matrix or Edit User) are unioned together, so
            someone with two roles gets every module either role has checked below.</p>
    </div>
</div>

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (saved) { %>
    <div class="alert alert-success">Capabilities saved.</div>
<% } %>

<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white"><h5 class="mb-0">+ Add a New Role</h5></div>
    <div class="card-body">
        <form action="/super-admin/roles/new" method="POST" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Role name</label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Front Desk" required>
            </div>
            <div class="col-md-4">
                <button class="btn btn-success">Add Role</button>
            </div>
        </form>
        <small class="text-muted d-block mt-2">New roles start with NO capabilities granted - check the modules it should have access to below, then Save.</small>
    </div>
</div>

<% roles.forEach(function(role) { %>
    <div class="card shadow mb-4">
        <div class="card-header d-flex justify-content-between align-items-center <%= role.is_system ? 'bg-secondary text-white' : 'bg-info text-dark' %>">
            <h5 class="mb-0">
                <%= role.name %>
                <% if (role.is_system) { %><span class="badge bg-light text-dark ms-2">Built-in</span><% } %>
            </h5>
            <% if (!role.is_system) { %>
                <form action="/super-admin/roles/<%= role.id %>/delete" method="POST" onsubmit="return confirm('Delete the &quot;' + <%- JSON.stringify(role.name) %> + '&quot; role? This only works if nobody currently holds it.');" class="mb-0">
                    <button class="btn btn-outline-danger btn-sm">Delete Role</button>
                </form>
            <% } %>
        </div>
        <div class="card-body">
            <form action="/super-admin/roles/<%= role.id %>/capabilities" method="POST">
                <div class="row">
                    <% capabilityList.forEach(function(cap) { %>
                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="capabilities" value="<%= cap.key %>"
                                    id="cap<%= role.id %>_<%= cap.key %>"
                                    <%= role.capabilities.includes(cap.key) ? 'checked' : '' %>>
                                <label class="form-check-label" for="cap<%= role.id %>_<%= cap.key %>"><%= cap.label %></label>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <button class="btn btn-primary mt-2">Save Capabilities for <%= role.name %></button>
            </form>
        </div>
    </div>
<% }) %>

<%- include("../partials/footer") %>
