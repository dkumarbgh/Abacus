<%- include("../partials/header") %>
<%- include("../partials/superAdminNav") %>

<a href="/super-admin" class="btn btn-outline-secondary btn-sm mb-3">&larr; All Schools</a>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">➕ Create a New School</h5></div>
            <div class="card-body">

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form method="POST" action="/super-admin/schools/new">

                    <h6 class="text-muted">School Details</h6>
                    <div class="mb-3">
                        <label class="form-label">School Name</label>
                        <input type="text" name="school_name" class="form-control" value="<%= form.school_name || '' %>" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" name="school_phone" class="form-control" value="<%= form.school_phone || '' %>">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="school_email" class="form-control" value="<%= form.school_email || '' %>">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" name="school_address" class="form-control" value="<%= form.school_address || '' %>">
                    </div>

                    <hr>
                    <h6 class="text-muted">First Admin Login for This School</h6>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="admin_name" class="form-control" value="<%= form.admin_name || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email (used to log in)</label>
                        <input type="email" name="admin_email" class="form-control" value="<%= form.admin_email || '' %>" required>
                    </div>
                    <%- include("../partials/passwordField", { id: "newSchoolAdminPassword", name: "admin_password", label: "Password", required: true, minlength: 6 }) %>

                    <button class="btn btn-success w-100">Create School</button>
                </form>

            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>
