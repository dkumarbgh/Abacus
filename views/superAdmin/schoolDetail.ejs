<%- include("../partials/header") %>
<%- include("../partials/superAdminNav") %>

<a href="/super-admin" class="btn btn-outline-secondary btn-sm mb-3">&larr; All Schools</a>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><%= school.name %></h2>
    <div>
        <a href="/super-admin/schools/<%= school.id %>/login-as" class="btn btn-success">🔓 Login As This School (Full View)</a>
        <a href="/super-admin/schools/<%= school.id %>/edit" class="btn btn-outline-primary btn-sm">Edit School Details</a>
    </div>
</div>

<p class="text-muted">
    <%= school.address || "No address on file" %><br>
    <%= school.phone || "" %> <%= school.email ? "· " + school.email : "" %><br>
    Simple Fee Mode: <%= school.simple_fee_mode ? "ON" : "OFF" %>
</p>

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="row">

    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white"><h5>Add User to This School</h5></div>
            <div class="card-body">
                <form action="/super-admin/schools/<%= school.id %>/users/add" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required>
                    </div>
                    <%- include("../partials/passwordField", { id: "saAddPassword", name: "password", label: "Password", required: true, minlength: 6 }) %>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select name="role" class="form-select">
                            <option value="Teacher">Teacher</option>
                            <option value="Accountant">Accountant</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <button class="btn btn-success w-100">Add User</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white"><h5>Users at This School</h5></div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% if (users.length === 0) { %>
                            <tr><td colspan="4" class="text-center">No users yet.</td></tr>
                        <% } %>
                        <% users.forEach(function(u) { %>
                            <tr>
                                <td><%= u.name %></td>
                                <td><%= u.email %></td>
                                <td><span class="badge bg-secondary"><%= u.role %></span></td>
                                <td>
                                    <a href="/super-admin/schools/<%= school.id %>/users/edit/<%= u.id %>" class="btn btn-primary btn-sm">Edit</a>
                                    <a href="/super-admin/schools/<%= school.id %>/users/delete/<%= u.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Remove this user?')">Remove</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<%- include("../partials/footer") %>
