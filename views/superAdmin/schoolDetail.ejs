<%- include("../partials/header") %>
<%- include("../partials/superAdminNav") %>

<a href="/super-admin" class="btn btn-outline-secondary btn-sm mb-3">&larr; All Schools</a>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><%= school.name %></h2>
    <div>
        <a href="#add-user" class="btn btn-outline-success" id="jumpToAddUser">➕ Add Admin / User</a>
        <a href="/super-admin/schools/<%= school.id %>/login-as" class="btn btn-success">🔓 Login As This School (Full View)</a>
        <a href="/super-admin/schools/<%= school.id %>/edit" class="btn btn-outline-primary btn-sm">Edit School Details</a>
        <a href="/super-admin/schools/<%= school.id %>/delete-confirm" class="btn btn-outline-danger btn-sm">🗑️ Delete School</a>
    </div>
</div>

<p class="text-muted">
    <%= school.address || "No address on file" %><br>
    <%= school.phone || "" %> <%= school.email ? "· " + school.email : "" %><br>
    Simple Fee Mode: <%= school.simple_fee_mode ? "ON" : "OFF" %>
</p>

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="row">

    <div class="col-md-4">
        <div class="card shadow" id="add-user">
            <div class="card-header bg-primary text-white"><h5>Add Admin / User to This School</h5></div>
            <div class="card-body">
                <form action="/super-admin/schools/<%= school.id %>/users/add" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email / Username</label>
                        <input type="text" name="email" class="form-control" required autocapitalize="none">
                    </div>
                    <%- include("../partials/passwordField", { id: "saAddPassword", name: "password", label: "Password", required: true, minlength: 6 }) %>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select name="role" class="form-select">
                            <% roles.forEach(function(r) { %>
                                <option value="<%= r %>" <%= r === 'Teacher' ? 'selected' : '' %>><%= r %></option>
                            <% }) %>
                        </select>
                    </div>
                    <%- include("../partials/branchCheckboxes", { idPrefix: "saAdd", selectedIds: [], manageHint: "No branches yet - use Login As This School, then Lists, to add Branches / Centres." }) %>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="read_only" value="1" id="saAddReadOnly">
                        <label class="form-check-label" for="saAddReadOnly">👀 View-only (demo login - can see, can't change anything)</label>
                    </div>
                    <button class="btn btn-success w-100">Add User</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white"><h5>Users at This School</h5></div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr><th>Name</th><th>Email</th><th>Role</th><th>Branch(es)</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% if (users.length === 0) { %>
                            <tr><td colspan="5" class="text-center">No users yet.</td></tr>
                        <% } %>
                        <% users.forEach(function(u) { %>
                            <tr>
                                <td><%= u.name %></td>
                                <td><%= u.email %></td>
                                <td><span class="badge bg-secondary"><%= u.role %></span><% if (u.read_only) { %> <span class="badge bg-info text-dark">👀 View-only</span><% } %></td>
                                <td><% ((typeof userBranchMap !== "undefined" && userBranchMap[u.id]) || []).forEach(b => { %><span class="badge bg-light text-dark border me-1"><%= b.name %></span><% }) %></td>
                                <td>
                                    <a href="/super-admin/schools/<%= school.id %>/users/edit/<%= u.id %>" class="btn btn-primary btn-sm">Edit</a>
                                    <a href="/super-admin/schools/<%= school.id %>/users/delete/<%= u.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Remove this user?')">Remove</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script>
// "➕ Add Admin / User" (dashboard or header button) lands here: pre-select the
// requested role (?role=Admin) and put the cursor in Name.
(function () {
    const card = document.getElementById("add-user");
    if (!card) return;
    const form = card.querySelector("form");
    const focusForm = function (role) {
        const select = form.querySelector('select[name="role"]');
        if (role && select && Array.from(select.options).some(o => o.value === role)) select.value = role;
        card.scrollIntoView({ behavior: "smooth", block: "start" });
        const nameInput = form.querySelector('input[name="name"]');
        if (nameInput) nameInput.focus();
    };
    const params = new URLSearchParams(window.location.search);
    if (window.location.hash === "#add-user" || params.get("role")) {
        window.addEventListener("load", function () { focusForm(params.get("role")); });
    }
    const jump = document.getElementById("jumpToAddUser");
    if (jump) jump.addEventListener("click", function (e) { e.preventDefault(); focusForm("Admin"); });
})();
</script>

<%- include("../partials/footer") %>
