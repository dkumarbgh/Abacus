<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>Settings</h2>

<div class="row">

    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header bg-primary text-white"><h5>Fee Collection</h5></div>
            <div class="card-body">

                <h6>Simple Fee Mode</h6>
                <p class="text-muted">
                    When <strong>ON</strong>, fee collection no longer accepts a custom/partial
                    amount &mdash; each fee item just gets marked <strong>Paid</strong> or
                    <strong>Not Paid</strong> in one click (for the full amount due).
                    <br>
                    When <strong>OFF</strong>, staff can enter any amount, so partial payments
                    are allowed (the original behaviour).
                </p>

                <form action="/settings/fee-mode" method="POST">
                    <div class="form-check form-switch mb-3">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            role="switch"
                            id="simpleFeeModeSwitch"
                            name="simple_fee_mode"
                            onchange="this.form.submit()"
                            <%= simpleFeeMode ? "checked" : "" %>>
                        <label class="form-check-label" for="simpleFeeModeSwitch">
                            <% if (simpleFeeMode) { %>
                                <span class="badge bg-success">ON</span> &mdash; Paid / Not Paid only
                            <% } else { %>
                                <span class="badge bg-secondary">OFF</span> &mdash; Any amount (partial payments allowed)
                            <% } %>
                        </label>
                    </div>
                    <noscript><button class="btn btn-primary">Save</button></noscript>
                </form>

                <div class="small text-muted mt-2">
                    This can be switched back at any time &mdash; it only changes how new
                    payments are recorded from now on; past payment history is unaffected.
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-7 mt-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white"><h5>Student Form &mdash; Mandatory Fields</h5></div>
            <div class="card-body">

                <p class="text-muted">
                    Choose which of these fields must be filled in before a student can be
                    saved. <strong>Full Name</strong> and <strong>Class</strong> are always
                    required and aren't shown here. Unchecked fields stay optional and
                    won't be marked with <span class="text-danger">*</span> on the form.
                </p>

                <form action="/settings/fields/student" method="POST">
                    <div class="row">
                        <% studentFields.forEach(function(f) { %>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="mandatory_fields"
                                        value="<%= f.key %>"
                                        id="field_<%= f.key %>"
                                        <%= f.mandatory ? "checked" : "" %>>
                                    <label class="form-check-label" for="field_<%= f.key %>">
                                        <%= f.label %>
                                    </label>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <button class="btn btn-primary mt-2" type="submit">Save Field Settings</button>
                </form>

            </div>
        </div>
    <div class="col-md-7 mt-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white"><h5>Admission No.</h5></div>
            <div class="card-body">

                <form action="/settings/admission-no" method="POST">
                    <div class="form-check form-switch mb-3">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            role="switch"
                            id="admissionNoAutoSwitch"
                            name="admission_no_auto"
                            <%= admissionNo.auto ? "checked" : "" %>>
                        <label class="form-check-label" for="admissionNoAutoSwitch">
                            Auto-assign Admission No. when registering a student
                        </label>
                    </div>

                    <div class="mb-3" style="max-width:300px">
                        <label class="form-label">Prefix (optional)</label>
                        <input type="text" name="admission_no_prefix" class="form-control" placeholder="e.g. 2026/" value="<%= admissionNo.prefix %>">
                    </div>

                    <p class="small text-muted">
                        Next number to be assigned: <strong><%= admissionNo.preview %></strong>
                        (increments automatically each time - never resets by changing the prefix here).
                    </p>

                    <button class="btn btn-primary" type="submit">Save</button>
                </form>

            </div>
        </div>
    <div class="col-md-7 mt-4">
        <div class="card shadow">
            <div class="card-header bg-dark text-white"><h5>Backup</h5></div>
            <div class="card-body">
                <p class="text-muted">
                    Downloads a complete, consistent snapshot of the entire database (every school,
                    student, fee record, attendance entry - everything) as a single file. Keep this
                    somewhere safe, especially before any deploy or major change - if your host's
                    disk isn't persistent, this is your real backup.
                </p>
                <a href="/settings/backup" class="btn btn-dark">⬇ Download Full Database Backup</a>
            </div>
        </div>
    </div>

</div>

<%- include("partials/footer") %>
