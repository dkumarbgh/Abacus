<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container mt-4">

    <h2 class="mb-4">
        📅 Attendance Management
    </h2>

    <!-- Select Class & Date -->
    <form action="/attendance/load" method="GET">

        <div class="row mb-4">

            <div class="col-md-4">

                <label class="form-label">
                    Attendance Date
                </label>

                <input
                    type="date"
                    name="attendance_date"
                    class="form-control"
                    value="<%= selectedDate %>"
                    required>

            </div>

            <div class="col-md-4">

                <label class="form-label">
                    Class
                </label>

                <select
                    name="class_id"
                    class="form-select"
                    required>

                    <option value="">Select Class</option>

                    <% classes.forEach(function(c){ %>

                        <option
                            value="<%= c.id %>"
                            <%= selectedClass == c.id ? "selected" : "" %>>

                            <%= c.class_name %>

                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="col-md-4 d-flex align-items-end">

                <button
                    class="btn btn-primary w-100">

                    Load Students

                </button>

            </div>

        </div>

    </form>


    <% if(students.length > 0){ %>

    <form action="/attendance/save" method="POST">

        <input
            type="hidden"
            name="attendance_date"
            value="<%= selectedDate %>">

        <input
            type="hidden"
            name="class_id"
            value="<%= selectedClass %>">

        <table class="table table-bordered table-striped">

            <thead class="table-dark">

                <tr>

                    <th width="80">ID</th>

                    <th>Student Name</th>

                    <th width="150">
                        Present
                    </th>

                </tr>

            </thead>

            <tbody>

            <% students.forEach(function(student){ %>

                <tr>

                    <td>

                        <%= student.id %>

                    </td>

                    <td>

                        <%= student.name %>

                    </td>

                    <td class="text-center">

                        <input
                            type="checkbox"
                            name="student"
                            value="<%= student.id %>"
                            checked>

                    </td>

                </tr>

            <% }) %>

            </tbody>

        </table>

        <button
            class="btn btn-success">

            💾 Save Attendance

        </button>

    </form>

    <% } %>

</div>

<%- include("partials/footer") %>