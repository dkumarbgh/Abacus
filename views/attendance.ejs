<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container mt-4">

    <h2 class="mb-4">📅 <%= t('attendance.title') %></h2>

    <% if (importExportEnabled && currentUser && currentUser.roles && (currentUser.roles.includes('Admin') || currentUser.roles.includes('SuperAdmin'))) { %>
        <div class="mb-3">
            <a href="/attendance/import" class="btn btn-outline-success btn-sm"><%= t('attendance.import_button') %></a>
            <a href="/attendance/export" class="btn btn-outline-primary btn-sm"><%= t('attendance.export_button') %></a>
        </div>
    <% } %>

    <% if (features.faceRecognition) { %>
        <a href="/attendance/face-capture" class="btn btn-outline-primary mb-4">📷 Mark Attendance via Laptop Camera</a>
    <% } %>

    <!-- Smart Student Search - find anyone instantly by Roll No./Name,
         see their photo/Batch/Level at a glance, and jump straight to
         their roster without needing to already know which batch they're in. -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <label class="form-label small mb-1">🔍 Find a Student (Roll No. or Name)</label>
            <input type="text" id="smartSearch" class="form-control" placeholder="Start typing... e.g. a roll number or name" autocomplete="off">
            <div id="smartSearchResults" class="list-group mt-2" style="max-height:320px; overflow-y:auto;"></div>
        </div>
    </div>

    <!-- Select Batch & Date -->
    <form action="/attendance/load" method="GET" id="loadForm">
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label">Attendance Date</label>
                <input type="date" name="attendance_date" id="attendanceDateInput" class="form-control" value="<%= selectedDate %>" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Batch</label>
                <select name="batch_id" id="batchSelect" class="form-select" required>
                    <option value="">Select Batch</option>
                    <% batches.forEach(function(b) { %>
                        <option value="<%= b.id %>" <%= String(selectedBatch)===String(b.id) ? "selected" : "" %>><%= b.name %></option>
                    <% }) %>
                </select>
                <small class="text-muted">A batch can include students from different Levels - each student's Level is shown in the roster below.</small>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary w-100">Load Students</button>
            </div>
        </div>
    </form>

    <% if (roster.length > 0 || crossBatchEntries.length > 0) { %>

    <form action="/attendance/save" method="POST" id="attendanceForm">

        <input type="hidden" name="attendance_date" value="<%= selectedDate %>">
        <input type="hidden" name="batch_id" value="<%= selectedBatch %>">

        <div class="card shadow-sm mb-3">
            <div class="card-body d-flex align-items-end gap-2 flex-wrap">
                <div>
                    <label class="form-label small mb-1" for="bulkHoursInput">Set Hours for All Students</label>
                    <input type="number" step="0.5" min="0" max="12" id="bulkHoursInput" class="form-control form-control-sm" style="width:120px;" placeholder="e.g. 2">
                </div>
                <button type="button" id="bulkHoursApplyBtn" class="btn btn-outline-primary btn-sm">Apply to All</button>
                <small class="text-muted">Sets this value for everyone currently marked Present (or added from another batch) - Absent students don't have hours recorded.</small>
            </div>
        </div>

        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th width="60">Photo</th>
                    <th width="120">Roll No.</th>
                    <th>Student Name</th>
                    <th width="110">Level</th>
                    <th width="100">Batch</th>
                    <th width="120">Present</th>
                    <th width="140">Hours Attended</th>
                </tr>
            </thead>
            <tbody>
                <% roster.forEach(function(student) { %>
                    <tr id="student-row-<%= student.id %>">
                        <td class="text-center">
                            <% if (student.photo_path) { %>
                                <img src="<%= student.photo_path %>" alt="" style="width:36px; height:36px; object-fit:cover; border-radius:50%;">
                            <% } else { %>
                                <span style="display:inline-block; width:36px; height:36px; border-radius:50%; background:#e9ecef; color:#999; line-height:36px;">👤</span>
                            <% } %>
                        </td>
                        <td><%= student.admission_no || "-" %></td>
                        <td><%= student.name %></td>
                        <td><%= student.level_name || "-" %></td>
                        <td><span class="badge bg-secondary">Home</span></td>
                        <td class="text-center">
                            <input type="checkbox" name="student" value="<%= student.id %>" class="present-checkbox"
                                data-hours-input="hours_<%= student.id %>" <%= student.checked ? "checked" : "" %>>
                        </td>
                        <td>
                            <input type="number" step="0.5" min="0" max="12" name="hours_<%= student.id %>" id="hours_<%= student.id %>"
                                class="form-control form-control-sm" value="<%= student.hours %>" <%= student.checked ? "" : "disabled" %>>
                        </td>
                    </tr>
                <% }) %>
                <% crossBatchEntries.forEach(function(entry) { %>
                    <tr class="table-warning" id="cross-row-<%= entry.id %>">
                        <td class="text-center">
                            <% if (entry.photo_path) { %>
                                <img src="<%= entry.photo_path %>" alt="" style="width:36px; height:36px; object-fit:cover; border-radius:50%;">
                            <% } else { %>
                                <span style="display:inline-block; width:36px; height:36px; border-radius:50%; background:#e9ecef; color:#999; line-height:36px;">👤</span>
                            <% } %>
                        </td>
                        <td><%= entry.admission_no || "-" %></td>
                        <td><%= entry.name %></td>
                        <td><%= entry.level_name || "-" %></td>
                        <td><span class="badge bg-warning text-dark">Different Batch<%= entry.home_batch_name ? (" (" + entry.home_batch_name + ")") : "" %></span></td>
                        <td class="text-center">
                            <input type="checkbox" checked disabled>
                            <input type="hidden" name="cross_batch_student" value="<%= entry.id %>">
                        </td>
                        <td>
                            <input type="number" step="0.5" min="0" max="12" name="hours_<%= entry.id %>"
                                class="form-control form-control-sm" value="<%= entry.hours %>">
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <script>
            // Hours input only makes sense while the student is marked
            // Present - disable it (so it doesn't submit a stray value)
            // and grey it out whenever their checkbox is unchecked.
            document.querySelectorAll('.present-checkbox').forEach(cb => {
                cb.addEventListener('change', function () {
                    const hoursInput = document.getElementById(this.dataset.hoursInput);
                    if (!hoursInput) return;
                    hoursInput.disabled = !this.checked;
                });
            });
        </script>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <label class="form-label small mb-1"><%= t('attendance.add_cross_batch_label') %></label>
                <div class="d-flex gap-2">
                    <input type="text" id="crossBatchSearch" class="form-control" placeholder="<%= t('attendance.search_placeholder') %>">
                </div>
                <div id="crossBatchResults" class="list-group mt-2"></div>

                <hr>

                <label class="form-label small mb-1"><%= t('attendance.add_from_batch_label') %></label>
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <select id="bulkBatchSelect" class="form-select">
                            <option value=""><%= t('attendance.add_from_batch_select') %></option>
                            <% batches.forEach(function(b) { %>
                                <% if (String(b.id) !== String(selectedBatch)) { %>
                                    <option value="<%= b.id %>"><%= b.name %></option>
                                <% } %>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div id="bulkBatchChecklistWrap" class="mt-2" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <button type="button" id="bulkSelectAllBtn" class="btn btn-sm btn-outline-secondary"><%= t('attendance.select_all') %></button>
                            <button type="button" id="bulkClearAllBtn" class="btn btn-sm btn-outline-secondary"><%= t('attendance.clear_all') %></button>
                        </div>
                        <button type="button" id="bulkAddSelectedBtn" class="btn btn-sm btn-success"><%= t('attendance.add_selected') %></button>
                    </div>
                    <div id="bulkBatchChecklist" class="list-group" style="max-height:320px; overflow-y:auto;"></div>
                </div>
            </div>
        </div>

        <button class="btn btn-success"><%= t('attendance.save_button') %></button>

    </form>

    <% } else if (selectedBatch) { %>
        <p class="text-muted"><%= t('attendance.no_students') %></p>
    <% } %>

</div>

<script>
// Pre-fills the hours box when a student is added via cross-batch search;
// School-configurable default (see Settings > Attendance).
const DEFAULT_HOURS_ATTENDED = <%= defaultHours %>;

// Smart Student Search - the main new entry point: find a student by
// Roll No./Name without needing to already know their Batch, see their
// photo/Batch/Level at a glance, and jump straight to their roster with
// them scrolled-to and highlighted.
// Keyed by student id so jumpToStudent() (below) can get at a result's full
// details (name/photo/batch/level) without another round-trip - needed now
// that a cross-batch student can be added straight from this search instead
// of always navigating away.
const smartSearchStudentsById = {};

const smartSearch = document.getElementById('smartSearch');
if (smartSearch) {
    let smartDebounce;
    smartSearch.addEventListener('input', function () {
        clearTimeout(smartDebounce);
        const q = this.value.trim();
        const resultsArea = document.getElementById('smartSearchResults');
        if (q.length < 2) { resultsArea.innerHTML = ''; return; }
        smartDebounce = setTimeout(async () => {
            const res = await fetch('/attendance/search-students?q=' + encodeURIComponent(q));
            const data = await res.json();
            if (!data.ok) return;
            if (data.students.length === 0) {
                resultsArea.innerHTML = '<div class="list-group-item text-muted">No matches</div>';
                return;
            }
            data.students.forEach(s => { smartSearchStudentsById[s.id] = s; });
            resultsArea.innerHTML = data.students.map(s => {
                const photo = s.photo_path
                    ? `<img src="${s.photo_path}" alt="" style="width:40px; height:40px; object-fit:cover; border-radius:50%;">`
                    : `<span style="display:inline-block; width:40px; height:40px; border-radius:50%; background:#e9ecef; color:#999; line-height:40px; text-align:center;">👤</span>`;
                const batchBadge = s.batch_name ? `<span class="badge bg-secondary">${s.batch_name}</span>` : `<span class="badge bg-light text-dark border">No batch</span>`;
                const levelBadge = s.level_name ? `<span class="badge bg-primary">${s.level_name}</span>` : '';
                return `
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3"
                        onclick="jumpToStudent(${s.id})">
                        ${photo}
                        <span class="flex-grow-1">
                            <div><strong>${s.name}</strong> ${s.admission_no ? '(' + s.admission_no + ')' : ''}</div>
                            <div>${batchBadge} ${levelBadge}</div>
                        </span>
                    </button>
                `;
            }).join('');
        }, 250);
    });
}

// A batch's sheet is already loaded on screen (the #attendanceForm only
// renders once a batch has been picked and Loaded - see the roster/
// crossBatchEntries check further up the page).
function currentlyLoadedBatchId() {
    const form = document.getElementById('attendanceForm');
    if (!form) return null;
    const hidden = form.querySelector('input[name="batch_id"]');
    return hidden ? hidden.value : null;
}

function jumpToStudent(studentId) {

    const student = smartSearchStudentsById[studentId];
    const loadedBatchId = currentlyLoadedBatchId();

    // Nothing loaded yet - this is the very first thing being picked, so
    // there's no existing roster to preserve. Land on the student's own
    // batch, same as before.
    if (!loadedBatchId) {
        if (!student || !student.batch_id) {
            alert('This student has no Batch assigned yet - set one from their Edit Student page first.');
            return;
        }
        const date = document.getElementById('attendanceDateInput').value || new Date().toISOString().slice(0, 10);
        const params = new URLSearchParams({
            batch_id: student.batch_id,
            attendance_date: date,
            highlight_student_id: studentId
        });
        window.location.href = '/attendance/load?' + params.toString();
        return;
    }

    // A batch is already loaded on screen. Rather than navigating away (which
    // was silently discarding whatever batch/roster was already being marked
    // - see Deepak's report), keep it and either just highlight the student
    // if they're already on the sheet, or add them onto it as a cross-batch
    // entry, exactly like the "Add from Different Batch" search below does.
    const alreadyOnScreen = document.getElementById('student-row-' + studentId) || document.getElementById('cross-row-' + studentId);
    if (!alreadyOnScreen && student && String(student.batch_id) !== String(loadedBatchId)) {
        addCrossBatchStudent(studentId, student.name, student.admission_no || '', student.photo_path || '', student.level_name || '', student.batch_name || '');
    }

    const row = document.getElementById('student-row-' + studentId) || document.getElementById('cross-row-' + studentId);
    if (row) {
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        row.style.transition = 'background-color 0.3s';
        row.style.backgroundColor = '#fff3cd';
        setTimeout(() => { row.style.backgroundColor = ''; }, 2500);
    }

}

// If we landed here via a smart-search jump, scroll to and highlight that
// student's row so it's obvious at a glance, without hunting through the roster.
<% if (highlightStudentId) { %>
(function () {
    const row = document.getElementById('student-row-<%= highlightStudentId %>') || document.getElementById('cross-row-<%= highlightStudentId %>');
    if (row) {
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        row.style.transition = 'background-color 0.3s';
        row.style.backgroundColor = '#fff3cd';
        setTimeout(() => { row.style.backgroundColor = ''; }, 2500);
    }
})();
<% } %>

// Cross-batch student search + add.
const searchBox = document.getElementById('crossBatchSearch');
if (searchBox) {
    // This box sits inside #attendanceForm - without this, pressing Enter
    // while searching submits (and saves) the whole attendance form and
    // reloads the page, instead of just picking a search result.
    searchBox.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') e.preventDefault();
    });
    let debounceTimer;
    searchBox.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        const q = this.value.trim();
        const resultsArea = document.getElementById('crossBatchResults');
        if (q.length < 2) { resultsArea.innerHTML = ''; return; }
        debounceTimer = setTimeout(async () => {
            const res = await fetch('/attendance/search-students?q=' + encodeURIComponent(q));
            const data = await res.json();
            if (!data.ok) return;
            resultsArea.innerHTML = data.students.map(s => `
                <button type="button" class="list-group-item list-group-item-action" onclick="addCrossBatchStudent(${s.id}, '${s.name.replace(/'/g, "\\'")}', '${(s.admission_no || '').replace(/'/g, "\\'")}', '${(s.photo_path || '').replace(/'/g, "\\'")}', '${(s.level_name || '').replace(/'/g, "\\'")}', '${(s.batch_name || '').replace(/'/g, "\\'")}')">
                    ${s.name} ${s.admission_no ? '(' + s.admission_no + ')' : ''}
                    ${s.batch_name ? '<span class="badge bg-secondary ms-1">' + s.batch_name + '</span>' : '<span class="badge bg-light text-dark border ms-1">No batch</span>'}
                    ${s.level_name ? '<span class="badge bg-primary ms-1">' + s.level_name + '</span>' : ''}
                </button>
            `).join('') || '<div class="list-group-item text-muted">No matches</div>';
        }, 250);
    });
}

// Builds (or re-builds) the "cross-batch visitor" table row - used both by
// the search-and-click flow above and the bulk "add from batch" flow below,
// so the two stay in sync instead of drifting apart. Always creates all 7
// <td>s to match the table's header (Photo/Roll/Name/Level/Batch/Present/
// Hours) - a row with fewer cells than the header silently shifts every
// later cell left by one, which is what caused the misaligned "Present"/
// "Batch" columns and the student LOOKING like they belonged to the
// current batch when they'd been added from a different one.
function addCrossBatchStudent(id, name, admissionNo, photoPath, levelName, batchName) {
    // Guards against adding someone twice AND against adding someone who's
    // already on the home roster for this batch (searching can surface a
    // student who's already checked in below) - either case would
    // otherwise submit two attendance rows for the same student+date.
    if (document.getElementById('cross-row-' + id) || document.getElementById('student-row-' + id)) return;
    const tbody = document.querySelector('#attendanceForm table tbody');
    const tr = document.createElement('tr');
    tr.className = 'table-warning';
    tr.id = 'cross-row-' + id;
    const photoCell = photoPath
        ? `<img src="${photoPath}" alt="" style="width:36px; height:36px; object-fit:cover; border-radius:50%;">`
        : `<span style="display:inline-block; width:36px; height:36px; border-radius:50%; background:#e9ecef; color:#999; line-height:36px;">👤</span>`;
    const batchLabel = 'Different Batch' + (batchName ? ` (${batchName})` : '');
    tr.innerHTML = `
        <td class="text-center">${photoCell}</td>
        <td>${admissionNo || '-'}</td>
        <td>${name}</td>
        <td>${levelName || '-'}</td>
        <td><span class="badge bg-warning text-dark">${batchLabel}</span></td>
        <td class="text-center">
            <input type="checkbox" checked disabled>
            <input type="hidden" name="cross_batch_student" value="${id}">
        </td>
        <td>
            <input type="number" step="0.5" min="0" max="12" name="hours_${id}" class="form-control form-control-sm" value="${DEFAULT_HOURS_ATTENDED}">
        </td>
    `;
    tbody.appendChild(tr);
    document.getElementById('crossBatchSearch').value = '';
    document.getElementById('crossBatchResults').innerHTML = '';
}

// "Set Hours for All Students" - applies one value to every currently
// enabled hours input (Present home-roster students + all cross-batch
// visitors, who are always Present) in one click instead of editing each
// student's box by hand.
const bulkHoursInput = document.getElementById('bulkHoursInput');
const bulkHoursApplyBtn = document.getElementById('bulkHoursApplyBtn');
if (bulkHoursApplyBtn) {
    bulkHoursApplyBtn.addEventListener('click', () => {
        const val = bulkHoursInput.value;
        if (val === '') return;
        // Deliberately NOT filtered to :not(:disabled) - a disabled hours
        // field just means that student is currently unchecked (Absent);
        // it should still pick up the bulk value so it's ready to go the
        // moment someone checks them Present, instead of only updating
        // whoever already happened to be checked when Apply was clicked.
        document.querySelectorAll('#attendanceForm table tbody input[type="number"][name^="hours_"]').forEach(inp => {
            inp.value = val;
        });
    });
    // Same Enter-key concern as the search boxes above - this input is
    // inside #attendanceForm too.
    bulkHoursInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            bulkHoursApplyBtn.click();
        }
    });
}

// Bulk "add several students from another batch at once" - pick a batch,
// see everyone in it as a checklist, check off however many actually
// showed up today, and add them all with one click instead of searching
// and clicking one name at a time.
const bulkBatchSelect = document.getElementById('bulkBatchSelect');
if (bulkBatchSelect) {

    bulkBatchSelect.addEventListener('change', async function () {

        const checklistWrap = document.getElementById('bulkBatchChecklistWrap');
        const checklist = document.getElementById('bulkBatchChecklist');

        if (!this.value) {
            checklistWrap.style.display = 'none';
            checklist.innerHTML = '';
            return;
        }

        checklist.innerHTML = '<div class="list-group-item text-muted">Loading...</div>';
        checklistWrap.style.display = 'block';

        const res = await fetch('/attendance/batch-students?batch_id=' + this.value);
        const data = await res.json();
        if (!data.ok) { checklist.innerHTML = '<div class="list-group-item text-danger">Could not load students.</div>'; return; }

        // Already-on-screen students (home roster + already-added cross-batch
        // entries) shouldn't be offered again.
        const alreadyOnScreen = new Set(
            Array.from(document.querySelectorAll('[id^="student-row-"], [id^="cross-row-"]'))
                .map(el => el.id.replace('student-row-', '').replace('cross-row-', ''))
        );
        const available = data.students.filter(s => !alreadyOnScreen.has(String(s.id)));

        if (available.length === 0) {
            checklist.innerHTML = '<div class="list-group-item text-muted">Everyone in this batch is already on the sheet above.</div>';
            return;
        }

        // The batch these students are coming FROM is whichever one is
        // selected in the dropdown above - its visible option text is the
        // batch name, so the added rows can say "Different Batch (X)"
        // just like the direct-search flow does.
        const bulkBatchName = bulkBatchSelect.options[bulkBatchSelect.selectedIndex]
            ? bulkBatchSelect.options[bulkBatchSelect.selectedIndex].text
            : '';

        checklist.innerHTML = available.map(s => `
            <label class="list-group-item d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input bulk-batch-checkbox" value="${s.id}"
                       data-name="${s.name.replace(/"/g, '&quot;')}"
                       data-admission="${(s.admission_no || '').replace(/"/g, '&quot;')}"
                       data-photo="${(s.photo_path || '').replace(/"/g, '&quot;')}"
                       data-level="${(s.level_name || '').replace(/"/g, '&quot;')}"
                       data-batch="${bulkBatchName.replace(/"/g, '&quot;')}">
                <span>${s.name} ${s.admission_no ? '(' + s.admission_no + ')' : ''} ${s.level_name ? '- ' + s.level_name : ''}</span>
            </label>
        `).join('');

    });

    document.getElementById('bulkSelectAllBtn').addEventListener('click', () => {
        document.querySelectorAll('.bulk-batch-checkbox').forEach(cb => { cb.checked = true; });
    });
    document.getElementById('bulkClearAllBtn').addEventListener('click', () => {
        document.querySelectorAll('.bulk-batch-checkbox').forEach(cb => { cb.checked = false; });
    });

    document.getElementById('bulkAddSelectedBtn').addEventListener('click', () => {
        const checked = document.querySelectorAll('.bulk-batch-checkbox:checked');
        checked.forEach(cb => {
            addCrossBatchStudent(cb.value, cb.dataset.name, cb.dataset.admission, cb.dataset.photo, cb.dataset.level, cb.dataset.batch);
        });
        // Re-trigger the batch dropdown's change handler to refresh the
        // checklist (now excluding everyone just added).
        bulkBatchSelect.dispatchEvent(new Event('change'));
    });

}

</script>

<%- include("partials/footer") %>
