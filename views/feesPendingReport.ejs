<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>Fees Pending Report
    <% if (simpleFeeMode) { %><span class="badge bg-warning text-dark align-middle">Simple Fee Mode: amounts hidden</span><% } %>
</h2>

<div class="row mb-3">
    <div class="col-md-4">
        <form method="GET" action="/reports/fees-pending">
            <select name="class_id" class="form-select" onchange="this.form.submit()">
                <option value="">All Classes</option>
                <% classes.forEach(c => { %>
                    <option value="<%= c.id %>" <%= class_id==c.id ? "selected" : "" %>><%= c.class_name %></option>
                <% }) %>
            </select>
        </form>
    </div>
    <div class="col-md-8 text-end">
        <form method="POST" action="/reports/fees-pending/remind" onsubmit="return confirm('Send a WhatsApp reminder to every guardian listed below?')">
            <input type="hidden" name="class_id" value="<%= class_id %>">
            <button class="btn btn-warning" <%= pending.length===0 ? "disabled" : "" %>>
                📲 Send WhatsApp Reminder to All Below (<%= pending.length %>)
            </button>
        </form>
    </div>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Student</th><th>Class</th><th>Guardian Phone</th>
            <th><%= simpleFeeMode ? "Status" : "Total Due" %></th>
        </tr>
    </thead>
    <tbody>
        <% if (pending.length === 0) { %>
            <tr><td colspan="4" class="text-center">No pending fees 🎉</td></tr>
        <% } %>
        <% pending.forEach(r => { %>
            <tr>
                <td><a href="/reports/student/<%= r.student.id %>"><%= r.student.name %></a></td>
                <td><%= r.student.class_name || "-" %></td>
                <td><%= r.student.guardian_phone || "-" %></td>
                <td>
                    <% if (simpleFeeMode) { %>
                        <span class="badge bg-danger">Pending</span>
                    <% } else { %>
                        <b>₹<%= r.totalDue %></b>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<a href="/reports" class="btn btn-link">&larr; Back to Reports</a>

<%- include("partials/footer") %>
