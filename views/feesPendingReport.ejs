<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>Fees Pending Report
    <% if (simpleFeeMode) { %><span class="badge bg-warning text-dark align-middle">Simple Fee Mode: amounts hidden</span><% } %>
</h2>

<div class="row mb-3 g-2">
    <div class="col-md-3">
        <form method="GET" action="/reports/fees-pending" class="d-flex">
            <input type="text" name="student_name" class="form-control" placeholder="🔍 Search by student name..." value="<%= student_name %>">
            <input type="hidden" name="batch_id" value="<%= batch_id %>">
            <input type="hidden" name="level_id" value="<%= level_id %>">
            <input type="hidden" name="class_id" value="<%= class_id %>">
            <input type="hidden" name="branch_id" value="<%= branch_id %>">
            <button class="btn btn-primary ms-1">🔍</button>
            <input type="hidden" name="include_future" value="<%= include_future %>">
        </form>
    </div>
    <div class="col-md-3">
        <form method="GET" action="/reports/fees-pending">
            <select name="batch_id" class="form-select" onchange="this.form.submit()">
                <option value="">All Batches</option>
                <% batches.forEach(b => { %>
                    <option value="<%= b.id %>" <%= String(batch_id)===String(b.id) ? "selected" : "" %>><%= b.name %></option>
                <% }) %>
            </select>
            <input type="hidden" name="level_id" value="<%= level_id %>">
            <input type="hidden" name="class_id" value="<%= class_id %>">
            <input type="hidden" name="branch_id" value="<%= branch_id %>">
            <input type="hidden" name="student_name" value="<%= student_name %>">
            <input type="hidden" name="include_future" value="<%= include_future %>">
        </form>
    </div>
    <div class="col-md-2">
        <form method="GET" action="/reports/fees-pending">
            <select name="level_id" class="form-select" onchange="this.form.submit()">
                <option value="">All Levels</option>
                <% levels.forEach(l => { %>
                    <option value="<%= l.id %>" <%= String(level_id)===String(l.id) ? "selected" : "" %>><%= l.name %></option>
                <% }) %>
            </select>
            <input type="hidden" name="batch_id" value="<%= batch_id %>">
            <input type="hidden" name="class_id" value="<%= class_id %>">
            <input type="hidden" name="branch_id" value="<%= branch_id %>">
            <input type="hidden" name="student_name" value="<%= student_name %>">
            <input type="hidden" name="include_future" value="<%= include_future %>">
        </form>
    </div>
    <div class="col-md-2">
        <form method="GET" action="/reports/fees-pending">
            <select name="class_id" class="form-select" onchange="this.form.submit()">
                <option value="">All Standards / Classes</option>
                <% classes.forEach(c => { %>
                    <option value="<%= c.id %>" <%= String(class_id)===String(c.id) ? "selected" : "" %>><%= c.class_name %></option>
                <% }) %>
            </select>
            <input type="hidden" name="batch_id" value="<%= batch_id %>">
            <input type="hidden" name="level_id" value="<%= level_id %>">
            <input type="hidden" name="branch_id" value="<%= branch_id %>">
            <input type="hidden" name="student_name" value="<%= student_name %>">
            <input type="hidden" name="include_future" value="<%= include_future %>">
        </form>
    </div>
    <div class="col-md-2">
        <form method="GET" action="/reports/fees-pending">
            <select name="branch_id" class="form-select" onchange="this.form.submit()">
                <option value="">All Branches / Centres</option>
                <% branches.forEach(b => { %>
                    <option value="<%= b.id %>" <%= String(branch_id)===String(b.id) ? "selected" : "" %>><%= b.name %></option>
                <% }) %>
            </select>
            <input type="hidden" name="batch_id" value="<%= batch_id %>">
            <input type="hidden" name="level_id" value="<%= level_id %>">
            <input type="hidden" name="class_id" value="<%= class_id %>">
            <input type="hidden" name="student_name" value="<%= student_name %>">
            <input type="hidden" name="include_future" value="<%= include_future %>">
        </form>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12 text-end">
        <form method="POST" action="/reports/fees-pending/remind" onsubmit="return confirm('Send a WhatsApp reminder to every guardian listed below?')">
            <input type="hidden" name="batch_id" value="<%= batch_id %>">
            <input type="hidden" name="level_id" value="<%= level_id %>">
            <input type="hidden" name="class_id" value="<%= class_id %>">
            <input type="hidden" name="branch_id" value="<%= branch_id %>">
            <input type="hidden" name="student_name" value="<%= student_name %>">
            <button class="btn btn-warning" <%= pending.length===0 ? "disabled" : "" %>>
                📲 Send WhatsApp Reminder to All Below (<%= pending.length %>)
            </button>
            <input type="hidden" name="include_future" value="<%= include_future %>">
        </form>
    </div>
</div>

<%
    var toggleQs = new URLSearchParams({ batch_id: batch_id, level_id: level_id, class_id: class_id, branch_id: branch_id, student_name: student_name });
    if (!include_future) toggleQs.set("include_future", "1");
%>
<div class="alert alert-light border d-flex justify-content-between align-items-center py-2">
    <span>
        <% if (include_future) { %>
            Showing the <b>full-year balance</b>, including installments that are not due yet.
        <% } else { %>
            Showing fees <b>due as of today</b>. Installments whose due date hasn't arrived are not counted.
        <% } %>
    </span>
    <a class="btn btn-sm btn-outline-secondary" href="/reports/fees-pending?<%= toggleQs.toString() %>">
        <%= include_future ? "Show due as of today" : "Include future installments" %>
    </a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Student</th><th>Batch</th><th>Level</th><th>Standard/Class</th><th>Branch/Centre</th><th>WhatsApp 1 Number</th>
            <th><%= simpleFeeMode ? "Status" : (include_future ? "Full-Year Balance" : "Due Now") %></th>
            <% if (!simpleFeeMode && !include_future) { %><th>Full-Year Balance</th><% } %>
        </tr>
    </thead>
    <tbody>
        <% if (pending.length === 0) { %>
            <tr><td colspan="<%= (!simpleFeeMode && !include_future) ? 8 : 7 %>" class="text-center">No pending fees 🎉</td></tr>
        <% } %>
        <% pending.forEach(r => { %>
            <% const lvl = levels.find(l => String(l.id)===String(r.student.level_id)); %>
            <% const bat = batches.find(b => String(b.id)===String(r.student.batch_id)); %>
            <% const cls = classes.find(c => String(c.id)===String(r.student.class_id)); %>
            <% const brn = branches.find(b => String(b.id)===String(r.student.branch_id)); %>
            <tr>
                <td><a href="/reports/student/<%= r.student.id %>"><%= r.student.name %></a></td>
                <td><%= bat ? bat.name : "-" %></td>
                <td><%= lvl ? lvl.name : "-" %></td>
                <td><%= cls ? cls.class_name : "-" %></td>
                <td><%= brn ? brn.name : "-" %></td>
                <td><%= r.student.guardian_phone || "-" %></td>
                <td>
                    <% if (simpleFeeMode) { %>
                        <span class="badge bg-danger">Pending</span>
                    <% } else { %>
                        <b>₹<%= r.shownDue %></b>
                    <% } %>
                </td>
                <% if (!simpleFeeMode && !include_future) { %><td>₹<%= r.totalDue %></td><% } %>
            </tr>
        <% }) %>
    </tbody>
</table>

<a href="/reports" class="btn btn-link">&larr; Back to Reports</a>

<%- include("partials/footer") %>
