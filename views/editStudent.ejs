<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4>Edit Student</h4>
            </div>
            <div class="card-body">

                <% if (typeof errors !== 'undefined' && errors.length) { %>
                    <div class="alert alert-danger">
                        Please fill in the following required field<%= errors.length > 1 ? 's' : '' %>:
                        <strong><%= errors.join(', ') %></strong>
                    </div>
                <% } %>

                <% if (student.photo_path) { %>
                    <img src="<%= student.photo_path %>" alt="photo" width="90" class="rounded mb-3 border">
                <% } %>

                <form method="POST" action="/students/edit/<%= student.id %>" enctype="multipart/form-data">

                    <h6 class="text-muted">Basic Details</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" value="<%= student.name %>" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Roll Number
                                <% if (fieldSettings.admission_no) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="admission_no" class="form-control" value="<%= student.admission_no || '' %>"
                                   <%= fieldSettings.admission_no ? "required" : "" %>>
                            <% if (admissionNo.auto) { %>
                                <small class="text-muted">Auto-assign is ON for new students, but you can still edit this one manually.</small>
                            <% } %>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Age
                                <% if (fieldSettings.age) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="number" name="age" class="form-control" value="<%= student.age %>"
                                   <%= fieldSettings.age ? "required" : "" %>>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Gender
                                <% if (fieldSettings.gender) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <select name="gender" class="form-select" <%= fieldSettings.gender ? "required" : "" %>>
                                <option value="">Select</option>
                                <option value="Male" <%= student.gender==='Male' ? 'selected' : '' %>>Male</option>
                                <option value="Female" <%= student.gender==='Female' ? 'selected' : '' %>>Female</option>
                                <option value="Other" <%= student.gender==='Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Date of Birth
                                <% if (fieldSettings.dob) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="date" name="dob" class="form-control" value="<%= student.dob || '' %>"
                                   <%= fieldSettings.dob ? "required" : "" %>>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Mother Tongue
                                <% if (fieldSettings.mother_tongue) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="mother_tongue" class="form-control" value="<%= student.mother_tongue || '' %>"
                                   <%= fieldSettings.mother_tongue ? "required" : "" %>>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Class <span class="text-danger">*</span></label>
                        <select name="class_id" class="form-select" required>
                            <% classes.forEach(c=>{ %>
                                <option value="<%= c.id %>" <%= student.class_id==c.id ? "selected" : "" %>>
                                    <%= c.class_name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <hr>
                    <h6 class="text-muted">Academic / Enrollment Details</h6>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                School
                                <% if (fieldSettings.previous_school) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="previous_school" class="form-control" value="<%= student.previous_school || '' %>"
                                   <%= fieldSettings.previous_school ? "required" : "" %>>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Stream
                                <% if (fieldSettings.stream) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="stream" class="form-control" value="<%= student.stream || '' %>"
                                   <%= fieldSettings.stream ? "required" : "" %>>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Standard
                                <% if (fieldSettings.standard) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="standard" class="form-control" value="<%= student.standard || '' %>"
                                   <%= fieldSettings.standard ? "required" : "" %>>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Course
                                <% if (fieldSettings.course_id) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <select name="course_id" class="form-select" <%= fieldSettings.course_id ? "required" : "" %>>
                                <option value="">Select</option>
                                <% lists.course.forEach(function(item){ %>
                                    <option value="<%= item.id %>" <%= student.course_id==item.id ? "selected" : "" %>><%= item.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Batch
                                <% if (fieldSettings.batch_id) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <select name="batch_id" class="form-select" <%= fieldSettings.batch_id ? "required" : "" %>>
                                <option value="">Select</option>
                                <% lists.batch.forEach(function(item){ %>
                                    <option value="<%= item.id %>" <%= student.batch_id==item.id ? "selected" : "" %>><%= item.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Level
                                <% if (fieldSettings.level_id) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <select name="level_id" class="form-select" <%= fieldSettings.level_id ? "required" : "" %>>
                                <option value="">Select</option>
                                <% lists.level.forEach(function(item){ %>
                                    <option value="<%= item.id %>" <%= student.level_id==item.id ? "selected" : "" %>><%= item.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Branch / Centre
                                <% if (fieldSettings.branch_id) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <select name="branch_id" class="form-select" <%= fieldSettings.branch_id ? "required" : "" %>>
                                <option value="">Select</option>
                                <% lists.branch.forEach(function(item){ %>
                                    <option value="<%= item.id %>" <%= student.branch_id==item.id ? "selected" : "" %>><%= item.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <p class="small text-muted">
                        Don't see the option you need? <a href="/lists" target="_blank">Manage Courses/Batches/Levels/Branches</a>.
                    </p>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Total Hours in Month
                                <% if (fieldSettings.total_hours_per_month) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="number" name="total_hours_per_month" class="form-control" value="<%= student.total_hours_per_month || '' %>"
                                   <%= fieldSettings.total_hours_per_month ? "required" : "" %>>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Fee Due Date
                                <% if (fieldSettings.fee_due_date) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="date" name="fee_due_date" class="form-control" value="<%= student.fee_due_date || '' %>"
                                   <%= fieldSettings.fee_due_date ? "required" : "" %>>
                        </div>
                    </div>

                    <hr>
                    <h6 class="text-muted">Personal Details</h6>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Religion
                                <% if (fieldSettings.religion) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="religion" class="form-control" value="<%= student.religion || '' %>"
                                   <%= fieldSettings.religion ? "required" : "" %>>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Nationality
                                <% if (fieldSettings.nationality) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="nationality" class="form-control" value="<%= student.nationality || '' %>"
                                   <%= fieldSettings.nationality ? "required" : "" %>>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                Country
                                <% if (fieldSettings.country) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="country" class="form-control" value="<%= student.country || '' %>"
                                   <%= fieldSettings.country ? "required" : "" %>>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">
                                State
                                <% if (fieldSettings.state) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="state" class="form-control" value="<%= student.state || '' %>"
                                   <%= fieldSettings.state ? "required" : "" %>>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                City
                                <% if (fieldSettings.city) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="city" class="form-control" value="<%= student.city || '' %>"
                                   <%= fieldSettings.city ? "required" : "" %>>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">
                                Residential Address
                                <% if (fieldSettings.address) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="address" class="form-control" value="<%= student.address || '' %>"
                                   <%= fieldSettings.address ? "required" : "" %>>
                        </div>
                    </div>

                    <hr>
                    <h6 class="text-muted">Parent / Guardian Details</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Mother's Name
                                <% if (fieldSettings.mother_name) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="mother_name" class="form-control" value="<%= student.mother_name || '' %>"
                                   <%= fieldSettings.mother_name ? "required" : "" %>>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Father's Name
                                <% if (fieldSettings.father_name) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="father_name" class="form-control" value="<%= student.father_name || '' %>"
                                   <%= fieldSettings.father_name ? "required" : "" %>>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Mother's Occupation
                                <% if (fieldSettings.mother_occupation) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="mother_occupation" class="form-control" value="<%= student.mother_occupation || '' %>"
                                   <%= fieldSettings.mother_occupation ? "required" : "" %>>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Father's Occupation
                                <% if (fieldSettings.father_occupation) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="father_occupation" class="form-control" value="<%= student.father_occupation || '' %>"
                                   <%= fieldSettings.father_occupation ? "required" : "" %>>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Mother's Contact Number
                                <% if (fieldSettings.mother_phone) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="mother_phone" class="form-control" value="<%= student.mother_phone || '' %>"
                                   <%= fieldSettings.mother_phone ? "required" : "" %>>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Father's Contact Number
                                <% if (fieldSettings.father_phone) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="father_phone" class="form-control" value="<%= student.father_phone || '' %>"
                                   <%= fieldSettings.father_phone ? "required" : "" %>>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Mother's Email
                                <% if (fieldSettings.mother_email) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="email" name="mother_email" class="form-control" value="<%= student.mother_email || '' %>"
                                   <%= fieldSettings.mother_email ? "required" : "" %>>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Father's Email
                                <% if (fieldSettings.father_email) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="email" name="father_email" class="form-control" value="<%= student.father_email || '' %>"
                                   <%= fieldSettings.father_email ? "required" : "" %>>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Guardian Name
                                <% if (fieldSettings.guardian_name) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="guardian_name" class="form-control" value="<%= student.guardian_name || '' %>"
                                   <%= fieldSettings.guardian_name ? "required" : "" %>>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Guardian WhatsApp Number
                                <% if (fieldSettings.guardian_phone) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="text" name="guardian_phone" class="form-control" value="<%= student.guardian_phone || '' %>"
                                   <%= fieldSettings.guardian_phone ? "required" : "" %>>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">
                                Guardian Email
                                <% if (fieldSettings.guardian_email) { %><span class="text-danger">*</span><% } %>
                            </label>
                            <input type="email" name="guardian_email" class="form-control" value="<%= student.guardian_email || '' %>"
                                   <%= fieldSettings.guardian_email ? "required" : "" %>>
                        </div>
                    </div>

                    <hr>
                    <h6 class="text-muted">Fee &amp; Installments</h6>
                    <p class="small text-muted">
                        Editing Total Fee updates this student's personalized fee item (it won't duplicate it).
                        Any installment entered here is a NEW payment on top of what's already recorded -
                        check the <a href="/fee-payments/<%= student.id %>" target="_blank">Fee Collection page</a>
                        for full payment history.
                    </p>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Total Fee</label>
                            <input type="number" step="0.01" name="total_fee" class="form-control" placeholder="Leave blank to make no change">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Discount Type</label>
                            <select name="discount_type" class="form-select">
                                <option value="FLAT">Flat Amount (₹)</option>
                                <option value="PERCENT">Percentage (%)</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Discount Value</label>
                            <input type="number" step="0.01" name="discount_value" class="form-control" placeholder="Leave blank to make no change">
                        </div>
                    </div>

                    <div id="installmentsContainer">
                        <div class="row installment-row">
                            <div class="col-md-4 mb-2">
                                <label class="form-label small">New Installment Amount</label>
                                <input type="number" step="0.01" name="installment_amount" class="form-control">
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label small">Date</label>
                                <input type="date" name="installment_date" class="form-control">
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label small">Mode</label>
                                <select name="installment_mode" class="form-select">
                                    <option>Cash</option>
                                    <option>UPI</option>
                                    <option>Card</option>
                                    <option>Bank Transfer</option>
                                    <option>Cheque</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="addInstallmentRow()">+ Add Installment</button>

                    <hr>
                    <div class="mb-3">
                        <label class="form-label">Weekly Attendance Schedule</label>
                        <p class="small text-muted mb-2">Which days is this student expected in class - e.g. check Tuesday + Friday for "weekly twice". Auto-fills from the selected Batch's default days; adjust below if this student's own schedule differs. Leave all unchecked if not tracking this yet.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <% const dayNames = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"]; %>
                            <% dayNames.forEach(function(day, idx) { %>
                                <div class="form-check">
                                    <input type="checkbox" name="schedule_days" value="<%= idx %>" id="day<%= idx %>" class="form-check-input"
                                        <%= scheduleDays.includes(idx) ? "checked" : "" %>>
                                    <label class="form-check-label" for="day<%= idx %>"><%= day %></label>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <script>
                        // Batch -> default days lookup, so picking a batch can
                        // pre-fill the Weekly Attendance Schedule above. Only
                        // fires on a manual batch CHANGE (not on page load),
                        // so it never silently overwrites a schedule that was
                        // already set for this student.
                        const BATCH_DEFAULT_DAYS = {
                            <% lists.batch.forEach(function(b) { %>
                                "<%= b.id %>": <%- JSON.stringify((b.default_days || "").split(",").filter(d => d !== "").map(Number)) %>,
                            <% }) %>
                        };
                        const batchSelectEl = document.querySelector('select[name="batch_id"]');
                        if (batchSelectEl) {
                            batchSelectEl.addEventListener('change', function () {
                                const days = BATCH_DEFAULT_DAYS[this.value] || [];
                                if (days.length === 0) return;
                                document.querySelectorAll('input[name="schedule_days"]').forEach(cb => {
                                    cb.checked = days.includes(Number(cb.value));
                                });
                            });
                        }
                    </script>

                    <hr>
                    <div class="mb-3">
                        <label class="form-label">Replace Photo (optional)</label>
                        <input type="file" name="photo" accept="image/*" class="form-control">
                    </div>

                    <button class="btn btn-primary">Update Student</button>
                    <a href="/students" class="btn btn-secondary">Cancel</a>

                </form>

            </div>
        </div>
    </div>
</div>

<script>
function addInstallmentRow() {
    const container = document.getElementById('installmentsContainer');
    const row = document.createElement('div');
    row.className = 'row installment-row';
    row.innerHTML = `
        <div class="col-md-4 mb-2">
            <label class="form-label small">Installment Amount</label>
            <input type="number" step="0.01" name="installment_amount" class="form-control">
        </div>
        <div class="col-md-4 mb-2">
            <label class="form-label small">Date</label>
            <input type="date" name="installment_date" class="form-control">
        </div>
        <div class="col-md-4 mb-2">
            <label class="form-label small">Mode</label>
            <select name="installment_mode" class="form-select">
                <option>Cash</option>
                <option>UPI</option>
                <option>Card</option>
                <option>Bank Transfer</option>
                <option>Cheque</option>
            </select>
        </div>
    `;
    container.appendChild(row);
}
</script>

<%- include("partials/footer") %>
