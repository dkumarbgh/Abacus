<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<div class="container mt-4">

    <div class="row">

        <!-- Add Fee Structure -->

        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h4>Add Fee Structure</h4>
                </div>

                <div class="card-body">

                    <% if (simpleFeeMode) { %>
                        <div class="alert alert-warning py-2">
                            <strong>Simple Fee Mode is ON.</strong> The amount below is only used
                            internally to know when a fee is fully paid &mdash; it won't be shown
                            to staff on the collection or reports pages, just Paid / Not Paid.
                        </div>
                    <% } %>

                    <form action="/fee-structure/add" method="POST">

                        <!-- Class -->

                        <div class="mb-3">
                            <label class="form-label">Class</label>

                            <select name="class_id" class="form-select" required>

                                <option value="">Select Class</option>

                                <% classes.forEach(function(cls){ %>

                                    <option value="<%= cls.id %>">
                                        <%= cls.class_name %>
                                    </option>

                                <% }) %>

                            </select>
                        </div>

                        <!-- Fee Category -->

                        <div class="mb-3">

                            <label class="form-label">Fee Category</label>

                            <select name="fee_category_id"
                                    class="form-select"
                                    required>

                                <option value="">Select Category</option>

                                <% categories.forEach(function(cat){ %>

                                    <option value="<%= cat.id %>">
                                        <%= cat.fee_name %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>

                        <!-- Academic Year -->

                        <div class="mb-3">

                            <label class="form-label">
                                Academic Year
                            </label>

                            <input
                                type="text"
                                name="academic_year"
                                class="form-control"
                                placeholder="2026-2027"
                                required>

                        </div>

                        <!-- Amount -->

                        <div class="mb-3">

                            <label class="form-label">
                                Amount
                            </label>

                            <input
                                type="number"
                                name="amount"
                                class="form-control"
                                required>

                        </div>

                        <button class="btn btn-success w-100">

                            Save Fee Structure

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- Fee Structure List -->

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">

                    <h4 class="mb-0">Fee Structure</h4>
                    <% if (simpleFeeMode) { %>
                        <span class="badge bg-warning text-dark">Simple Fee Mode: amounts hidden</span>
                    <% } %>

                </div>

                <div class="card-body">

                    <p class="text-muted small">
                        Due dates are set per student now, not here &mdash; open a student's
                        <a href="/students">profile</a> to set their Fee Due Date.
                    </p>

                    <table class="table table-bordered table-hover">

                        <thead class="table-dark">

                            <tr>

                                <th>Class</th>
                                <th>Category</th>
                                <th>Academic Year</th>
                                <% if (!simpleFeeMode) { %><th>Amount</th><% } %>
                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                        <% if(structure.length===0){ %>

                            <tr>

                                <td colspan="5" class="text-center">

                                    No Fee Structure Found

                                </td>

                            </tr>

                        <% } %>

                        <% structure.forEach(function(item){ %>

                            <tr>

                                <td><%= item.class_name %></td>

                                <td><%= item.fee_name %></td>

                                <td><%= item.academic_year %></td>

                                <% if (!simpleFeeMode) { %>
                                    <td>₹ <%= item.amount %></td>
                                <% } %>

                                <td>

                                    <a
                                        href="/fee-structure/delete/<%= item.id %>"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this record?')">

                                        Delete

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/footer") %>
