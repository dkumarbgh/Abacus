<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<div class="container mt-4">

    <div class="row">

        <!-- Add Fee Structure -->

        <div class="col-md-4">

            <div class="card shadow mb-3">

                <div class="card-header bg-primary text-white">
                    <h4>Add Fee Structure</h4>
                </div>

                <div class="card-body">

                    <% if (simpleFeeMode) { %>
                        <div class="alert alert-warning py-2">
                            <strong>Simple Fee Mode is ON.</strong> The amount below is only used
                            internally to know when a fee is fully paid &mdash; it won't be shown
                            to staff on the collection or reports pages, just Paid / Not Paid.
                        </div>
                    <% } %>

                    <% if (levels.length === 0) { %>
                        <div class="alert alert-info py-2">No Levels set up yet. <a href="/lists">Add one first</a>.</div>
                    <% } %>

                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#singleTab">One Amount</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#autoTab">Auto (From Join Date)</a></li>
                    </ul>

                    <div class="tab-content">

                    <div class="tab-pane fade show active" id="singleTab">
                    <form action="/fee-structure/add" method="POST">

                        <div class="mb-3">
                            <label class="form-label">Level</label>
                            <select name="level_id" class="form-select" required>
                                <option value="">Select Level</option>
                                <% levels.forEach(function(lv){ %>
                                    <option value="<%= lv.id %>"><%= lv.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Fee Category</label>
                            <select name="fee_category_id" class="form-select" required>
                                <option value="">Select Category</option>
                                <% categories.forEach(function(cat){ %>
                                    <option value="<%= cat.id %>"><%= cat.fee_name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Academic Year</label>
                            <input type="text" name="academic_year" class="form-control" placeholder="2026-2027" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Amount</label>
                            <input type="number" name="amount" class="form-control" required>
                        </div>

                        <button class="btn btn-success w-100">Save Fee Structure</button>

                    </form>
                    </div>

                    <div class="tab-pane fade" id="autoTab">
                        <p class="small text-muted">
                            Sets a per-Level RATE rather than a fixed calendar template - each
                            student's own fee periods are generated starting from <strong>their
                            Date of Joining</strong> (set on their profile), not a fixed academic-
                            year start. A student joining in August on a Quarterly plan gets
                            Aug-Oct, Nov-Jan, Feb-Apr - not the school's calendar quarters.
                        </p>
                        <form action="/fee-structure/plans/add" method="POST">

                            <div class="mb-3">
                                <label class="form-label">Level</label>
                                <select name="level_id" class="form-select" required>
                                    <option value="">Select Level</option>
                                    <% levels.forEach(function(lv){ %>
                                        <option value="<%= lv.id %>"><%= lv.name %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Fee Category</label>
                                <select name="fee_category_id" class="form-select" required>
                                    <option value="">Select Category</option>
                                    <% categories.forEach(function(cat){ %>
                                        <option value="<%= cat.id %>"><%= cat.fee_name %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Academic Year</label>
                                <input type="text" name="academic_year" class="form-control" placeholder="2026-2027" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Duration</label>
                                <select name="duration_months" class="form-select">
                                    <option value="12" selected>12 months (default - a full year from each student's own join date)</option>
                                    <option value="6">6 months</option>
                                    <option value="3">3 months</option>
                                    <option value="24">24 months</option>
                                </select>
                                <small class="text-muted">
                                    Every student gets exactly this many months of periods, counted
                                    from THEIR OWN Date of Joining - someone joining in July gets
                                    periods running July through the following June, not a fixed
                                    calendar cutoff shared by everyone.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Payment Mode</label>
                                <select name="payment_mode" class="form-select">
                                    <option value="monthly">Monthly</option>
                                    <option value="bimonthly">Bimonthly</option>
                                    <option value="quarterly">Quarterly</option>
                                    <option value="half_yearly">Half-Yearly</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Amount per Period</label>
                                <input type="number" step="0.01" name="amount_per_period" class="form-control" placeholder="e.g. 1000" required>
                            </div>

                            <button class="btn btn-success w-100">Save Fee Plan</button>

                        </form>
                    </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Fee Structure List -->

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Fee Structure</h4>
                    <% if (simpleFeeMode) { %>
                        <span class="badge bg-warning text-dark">Simple Fee Mode: amounts hidden</span>
                    <% } %>
                </div>

                <div class="card-body">

                    <p class="text-muted small">
                        Due dates are set per student now, not here &mdash; open a student's
                        <a href="/students">profile</a> to set their Fee Due Date.
                    </p>

                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Level</th>
                                <th>Category</th>
                                <th>Payment Mode</th>
                                <th>Installment</th>
                                <th>Academic Year</th>
                                <% if (!simpleFeeMode) { %><th>Amount</th><% } %>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (singles.length === 0 && groups.length === 0) { %>
                                <tr><td colspan="7" class="text-center">No Fee Structure Found</td></tr>
                            <% } %>

                            <% singles.forEach(function(item){ %>
                                <tr>
                                    <td>
                                        <% if (item.level_name) { %>
                                            <%= item.level_name %>
                                        <% } else if (item.class_name) { %>
                                            <%= item.class_name %> <span class="badge bg-secondary">Class (legacy)</span>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td><%= item.fee_name %></td>
                                    <td><span class="badge bg-info text-dark">Single Payment</span></td>
                                    <td>-</td>
                                    <td><%= item.academic_year %></td>
                                    <% if (!simpleFeeMode) { %>
                                        <td>₹ <%= item.amount %></td>
                                    <% } %>
                                    <td>
                                        <a href="/fee-structure/delete/<%= item.id %>" class="btn btn-danger btn-sm"
                                           onclick="return confirm('Delete this record?')">Delete</a>
                                    </td>
                                </tr>
                            <% }) %>

                            <% const modeLabels = { monthly: 'Monthly', bimonthly: 'Bimonthly', quarterly: 'Quarterly', half_yearly: 'Half-Yearly' }; %>
                            <% groups.forEach(function(g, gIndex){ %>
                                <tr>
                                    <td>
                                        <% if (g.level_name) { %>
                                            <%= g.level_name %>
                                        <% } else if (g.class_name) { %>
                                            <%= g.class_name %> <span class="badge bg-secondary">Class (legacy)</span>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td><%= g.fee_name %></td>
                                    <td><span class="badge bg-info text-dark"><%= modeLabels[g.payment_mode] || g.payment_mode %></span></td>
                                    <td>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleGroup(<%= gIndex %>)">
                                            👁 View <%= g.installments.length %> installments
                                        </button>
                                    </td>
                                    <td><%= g.academic_year %></td>
                                    <% if (!simpleFeeMode) { %>
                                        <td>₹ <%= g.totalAmount %> total</td>
                                    <% } %>
                                    <td>
                                        <a href="/fee-structure/delete-plan?fee_category_id=<%= g.installments[0].fee_category_id %>&level_id=<%= g.installments[0].level_id || '' %>&class_id=<%= g.installments[0].class_id || '' %>&academic_year=<%= encodeURIComponent(g.academic_year) %>&payment_mode=<%= g.payment_mode %>"
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Delete the ENTIRE <%= g.payment_mode %> plan - all <%= g.installments.length %> installments? This cannot be undone.')">
                                            Delete Entire Plan
                                        </a>
                                    </td>
                                </tr>
                                <tr id="group-detail-<%= gIndex %>" style="display:none;">
                                    <td colspan="<%= simpleFeeMode ? 6 : 7 %>" class="bg-light">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead>
                                                <tr><th>Period</th><% if (!simpleFeeMode) { %><th>Amount</th><% } %><th>Action</th></tr>
                                            </thead>
                                            <tbody>
                                                <% g.installments.forEach(function(inst){ %>
                                                    <tr>
                                                        <td><%= inst.installment_label %></td>
                                                        <% if (!simpleFeeMode) { %><td>₹ <%= inst.amount %></td><% } %>
                                                        <td>
                                                            <a href="/fee-structure/delete/<%= inst.id %>" class="btn btn-outline-danger btn-sm"
                                                               onclick="return confirm('Delete just this one installment (<%= inst.installment_label %>)?')">Delete</a>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>

                </div>

            </div>

            <div class="card shadow mt-4">

                <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Fee Plans (Auto, From Join Date)</h4>
                </div>

                <div class="card-body">

                    <p class="text-muted small">
                        These generate each student's OWN fee periods from their Date of Joining -
                        not shown in the table above (per-student items live on each student's own
                        Fee Collection page). Use "Sync Students' Fee Periods" after a new student
                        joins, or after correcting someone's Date of Joining - it adds whatever's
                        missing and reshapes any still-unpaid periods to match the correction,
                        without ever touching a period that's already been paid or discounted.
                    </p>

                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr><th>Level</th><th>Category</th><th>Payment Mode</th><th>Academic Year</th><th>Duration</th><% if (!simpleFeeMode) { %><th>Amount/Period</th><% } %><th>Action</th></tr>
                        </thead>
                        <tbody>
                            <% if (feePlans.length === 0) { %>
                                <tr><td colspan="7" class="text-center">No Fee Plans set up yet.</td></tr>
                            <% } %>
                            <% feePlans.forEach(function(p) { %>
                                <tr>
                                    <td><%= p.level_name || "-" %></td>
                                    <td><%= p.fee_name %></td>
                                    <td><span class="badge bg-info text-dark"><%= modeLabels[p.payment_mode] || p.payment_mode %></span></td>
                                    <td><%= p.academic_year %></td>
                                    <td><%= p.duration_months || 12 %> months</td>
                                    <% if (!simpleFeeMode) { %><td>₹ <%= p.amount_per_period %></td><% } %>
                                    <td>
                                        <a href="/fee-structure/plans/<%= p.id %>/assign-missing" class="btn btn-outline-primary btn-sm"
                                           title="Adds missing periods and reshapes any unpaid periods for students whose join date was corrected">
                                            Sync Students' Fee Periods
                                        </a>
                                        <a href="/fee-structure/plans/<%= p.id %>/delete" class="btn btn-danger btn-sm"
                                           onclick="return confirm('Delete this Fee Plan? Already-generated student fee periods are kept - only future auto-assignment stops.')">Delete Plan</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
function toggleGroup(index) {
    const row = document.getElementById('group-detail-' + index);
    row.style.display = row.style.display === 'none' ? '' : 'none';
}
</script>

<%- include("../partials/footer") %>
