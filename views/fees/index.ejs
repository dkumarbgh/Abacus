
<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<div class="container mt-4">

    <div class="row">

        <!-- Add Fee Category -->

        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">

                    <h4>Add Fee Category</h4>

                </div>

                <div class="card-body">

                    <form action="/fees/add" method="POST">

                        <div class="mb-3">

                            <label class="form-label">
                                Fee Name
                            </label>

                            <input
                                type="text"
                                name="fee_name"
                                class="form-control"
                                required>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Description
                            </label>

                            <textarea
                                name="description"
                                class="form-control"
                                rows="3"></textarea>

                        </div>

                        <button class="btn btn-success w-100">

                            Save Fee Category

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- Fee List -->

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-success text-white">

                    <h4>Fee Categories</h4>

                </div>

                <div class="card-body">

                    <table class="table table-bordered table-hover">

                        <thead class="table-dark">

                            <tr>

                                <th>ID</th>
                                <th>Fee Name</th>
                                <th>Description</th>
                                <th width="120">Action</th>

                            </tr>

                        </thead>

                        <tbody>

                        <% if(fees.length===0){ %>

                            <tr>

                                <td colspan="4" class="text-center">

                                    No Fee Categories Found

                                </td>

                            </tr>

                        <% } %>

                        <% fees.forEach(function(fee){ %>

                            <tr>

                                <td><%= fee.id %></td>

                                <td><%= fee.fee_name %></td>

                                <td><%= fee.description %></td>

                                <td>

                                    <a
                                        href="/fees/delete/<%= fee.id %>"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this fee category?')">

                                        Delete

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/footer") %>