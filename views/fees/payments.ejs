<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<h2><%= t('fees.title') %></h2>

<% if (typeof importExportEnabled !== 'undefined' && importExportEnabled && currentUser && currentUser.roles && (currentUser.roles.includes('Admin') || currentUser.roles.includes('SuperAdmin'))) { %>
    <div class="mb-3">
        <a href="/fee-payments/import" class="btn btn-outline-success btn-sm"><%= t('fees.import_button') %></a>
        <a href="/fee-payments/export" class="btn btn-outline-primary btn-sm"><%= t('fees.export_button') %></a>
    </div>
<% } %>

<% if (students) { %>

    <!-- Student picker -->
    <div class="card shadow mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-6">
                    <form method="GET" action="/fee-payments">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control" placeholder="<%= t('fees.search_by_name') %>" value="<%= search %>">
                            <input type="hidden" name="roll_number" value="<%= rollNumber %>">
                            <button class="btn btn-primary">🔍 <%= t('common.search') %></button>
                        </div>
                    </form>
                </div>
                <div class="col-md-6">
                    <form method="GET" action="/fee-payments">
                        <div class="input-group">
                            <input type="text" name="roll_number" class="form-control" placeholder="<%= t('fees.search_by_roll_no') %>" value="<%= rollNumber %>">
                            <input type="hidden" name="search" value="<%= search %>">
                            <button class="btn btn-primary">🔍 <%= t('common.search') %></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr><th><%= t('common.name') %></th><th><%= t('attendance.roll_no') %></th><th><%= t('attendance.level') %></th><th></th></tr>
        </thead>
        <tbody>
            <% if (students.length === 0) { %>
                <tr><td colspan="4" class="text-center"><%= t('fees.no_students_found') %></td></tr>
            <% } %>
            <% students.forEach(s => { %>
                <tr>
                    <td><%= s.name %></td>
                    <td><%= s.admission_no || "-" %></td>
                    <td><%= s.level_name || "-" %></td>
                    <td>
                        <a href="/fee-payments/<%= s.id %>" class="btn btn-success btn-sm"><%= t('fees.collect_fee') %></a>
                        <a href="/student-fees/<%= s.id %>" class="btn btn-outline-primary btn-sm">Tuition &amp; Books</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

<% } else { %>

    <!-- Dues + payment form for a single student -->
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><%= student.name %> &mdash; <%= t('fees.fee_dues_heading') %></h5>
            <div>
                <a href="/student-fees/<%= student.id %>" class="btn btn-light btn-sm">Manage Tuition &amp; Books</a>
                <% if (simpleFeeMode) { %>
                    <span class="badge bg-warning text-dark"><%= t('fees.simple_mode_badge') %></span>
                <% } %>
            </div>
        </div>
        <div class="card-body">

            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <% if (simpleFeeMode) { %>
                            <th><%= t('fees.fee') %></th><th><%= t('fees.academic_year') %></th><th><%= t('common.status') %></th><th width="230"><%= t('fees.action') %></th>
                        <% } else { %>
                            <th><%= t('fees.fee') %></th><th><%= t('fees.academic_year') %></th><th><%= t('fees.total') %></th><th><%= t('fees.discount') %></th><th><%= t('fees.net') %></th><th><%= t('fees.paid') %></th><th><%= t('fees.due') %></th><th width="230"><%= t('fees.action') %></th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% if (dues.length === 0) { %>
                        <tr><td colspan="<%= simpleFeeMode ? 4 : 8 %>" class="text-center"><%= t('fees.no_fee_structure') %></td></tr>
                    <% } %>
                    <% dues.forEach(d => { %>
                        <% const displayName = d.fee_name + (d.installment_label ? ' - ' + d.installment_label : ''); %>
                        <tr class="<%= d.due > 0 ? 'table-warning' : 'table-success' %>">
                            <td><%= displayName %></td>
                            <td><%= d.academic_year %></td>
                            <% if (simpleFeeMode) { %>
                                <td>
                                    <% if (d.due > 0) { %>
                                        <span class="badge bg-danger"><%= t('fees.not_paid_badge') %></span>
                                    <% } else { %>
                                        <span class="badge bg-success"><%= t('fees.paid_badge') %></span>
                                    <% } %>
                                </td>
                            <% } else { %>
                                <td>₹<%= d.amount %></td>
                                <td>
                                    <% if (d.discount) { %>
                                        <span class="badge bg-info text-dark">
                                            <% if (d.discount.discount_type === 'PERCENT') { %>
                                                <%= d.discount.discount_value %>%
                                            <% } else { %>
                                                ₹<%= d.discount.discount_value %>
                                            <% } %>
                                        </span>
                                        <% if (d.discount.reason) { %>
                                            <div class="small text-muted"><%= d.discount.reason %></div>
                                        <% } %>
                                        <a href="/fee-payments/discount/remove/<%= d.discount.id %>"
                                           class="small text-danger"
                                           onclick="return confirm('Remove this discount?')"><%= t('fees.remove_discount') %></a>
                                    <% } else { %>
                                        <span class="text-muted">&mdash;</span>
                                    <% } %>
                                </td>
                                <td>₹<%= d.netAmount %></td>
                                <td>₹<%= d.paid %></td>
                                <td>₹<%= d.due %></td>
                            <% } %>
                            <td>
                                <% if (d.due > 0) { %>
                                    <% if (simpleFeeMode) { %>
                                        <form action="/fee-payments/mark-paid" method="POST" class="d-inline-flex align-items-center gap-1 flex-wrap">
                                            <input type="hidden" name="student_id" value="<%= student.id %>">
                                            <input type="hidden" name="fee_structure_id" value="<%= d.id %>">
                                            <select name="mode" class="form-select form-select-sm" style="width: auto;">
                                                <option>Cash</option>
                                                <option>UPI</option>
                                                <option>Card</option>
                                                <option>Bank Transfer</option>
                                                <option>Cheque</option>
                                            </select>
                                            <input type="text" name="reference_no" class="form-control form-control-sm"
                                                   placeholder="UTR / Cheque No. (optional)" style="width: 170px;">
                                            <button class="btn btn-sm btn-success" type="submit"
                                                    onclick="return confirm('Mark \'<%= displayName %>\' as fully PAID?')"><%= t('fees.mark_paid') %></button>
                                        </form>
                                    <% } else { %>
                                        <button class="btn btn-sm btn-success" type="button"
                                            onclick="payFee(<%= d.id %>, '<%= displayName %>', <%= d.due %>)">
                                            <%= t('fees.collect') %>
                                        </button>
                                    <% } %>
                                <% } else { %>
                                    <span class="badge bg-success"><%= t('fees.paid_badge') %></span>
                                <% } %>
                                <% if (!simpleFeeMode) { %>
                                    <button class="btn btn-sm btn-outline-info" type="button"
                                        onclick="discountFee(<%= d.id %>, '<%= displayName %>')">
                                        <%= t('fees.discount_waive') %>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

        </div>
    </div>

    <!-- Payment form (shown/populated via JS when "Collect" is clicked) - only relevant
         when Simple Fee Mode is OFF, since ON uses the one-click Mark Paid button above -->
    <% if (!simpleFeeMode) { %>
    <div class="card shadow mb-4" id="payCard" style="display:none">
        <div class="card-header bg-success text-white">
            <h5><%= t('fees.record_payment') %> &mdash; <span id="payFeeName"></span></h5>
        </div>
        <div class="card-body">
            <form action="/fee-payments/pay" method="POST">
                <input type="hidden" name="student_id" value="<%= student.id %>">
                <input type="hidden" name="fee_structure_id" id="payFeeStructureId">

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><%= t('fees.amount') %></label>
                        <input type="number" step="0.01" name="amount_paid" id="payAmount" class="form-control" required>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><%= t('fees.mode') %></label>
                        <select name="mode" class="form-select">
                            <option>Cash</option>
                            <option>UPI</option>
                            <option>Card</option>
                            <option>Bank Transfer</option>
                            <option>Cheque</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><%= t('fees.reference_no') %></label>
                        <input type="text" name="reference_no" class="form-control" placeholder="UTR / Cheque No. / Txn ID">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><%= t('fees.remarks') %></label>
                        <input type="text" name="remarks" class="form-control">
                    </div>
                </div>

                <button class="btn btn-success"><%= t('fees.save_payment') %></button>
            </form>
        </div>
    </div>
    <% } %>

    <!-- Discount / Waiver form (shown/populated via JS when "Discount/Waive" is clicked) -->
    <% if (!simpleFeeMode) { %>
    <div class="card shadow mb-4" id="discountCard" style="display:none">
        <div class="card-header bg-info text-dark">
            <h5><%= t('fees.discount_waive') %> &mdash; <span id="discountFeeName"></span></h5>
        </div>
        <div class="card-body">
            <form action="/fee-payments/discount" method="POST">
                <input type="hidden" name="student_id" value="<%= student.id %>">
                <input type="hidden" name="fee_structure_id" id="discountFeeStructureId">

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><%= t('fees.discount_type') %></label>
                        <select name="discount_type" class="form-select">
                            <option value="FLAT">Flat Amount (₹)</option>
                            <option value="PERCENT">Percentage (%)</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><%= t('fees.discount_value') %></label>
                        <input type="number" step="0.01" name="discount_value" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><%= t('fees.discount_reason') %></label>
                        <input type="text" name="reason" class="form-control" placeholder="e.g. Sibling discount, scholarship, staff ward">
                    </div>
                </div>

                <button class="btn btn-info"><%= t('fees.apply_discount') %></button>
                <button class="btn btn-outline-danger" type="submit" name="waive_full" value="1"
                        onclick="return confirm('Waive the FULL remaining amount for this fee item?')">
                    <%= t('fees.waive_full') %>
                </button>
            </form>
        </div>
    </div>
    <% } %>

    <script>
        function payFee(feeStructureId, feeName, due) {
            document.getElementById('discountCard').style.display = 'none';
            document.getElementById('payCard').style.display = 'block';
            document.getElementById('payFeeStructureId').value = feeStructureId;
            document.getElementById('payFeeName').innerText = feeName;
            document.getElementById('payAmount').value = due;
            document.getElementById('payCard').scrollIntoView({ behavior: 'smooth' });
        }
        function discountFee(feeStructureId, feeName) {
            document.getElementById('payCard').style.display = 'none';
            document.getElementById('discountCard').style.display = 'block';
            document.getElementById('discountFeeStructureId').value = feeStructureId;
            document.getElementById('discountFeeName').innerText = feeName;
            document.getElementById('discountCard').scrollIntoView({ behavior: 'smooth' });
        }
    </script>

    <!-- Payment history -->
    <div class="card shadow">
        <div class="card-header bg-secondary text-white">
            <h5><%= t('fees.payment_history') %></h5>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <% if (simpleFeeMode) { %>
                            <th><%= t('common.date') %></th><th><%= t('fees.receipt_no') %></th><th><%= t('fees.mode') %></th><th><%= t('fees.reference_no') %></th><th><%= t('fees.remarks') %></th><th></th>
                        <% } else { %>
                            <th><%= t('common.date') %></th><th><%= t('fees.receipt_no') %></th><th><%= t('fees.amount') %></th><th><%= t('fees.mode') %></th><th><%= t('fees.reference_no') %></th><th><%= t('fees.remarks') %></th><th></th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% if (payments.length === 0) { %>
                        <tr><td colspan="<%= simpleFeeMode ? 6 : 7 %>" class="text-center"><%= t('fees.no_payments') %></td></tr>
                    <% } %>
                    <% payments.forEach(p => { %>
                        <tr>
                            <td><%= p.payment_date %></td>
                            <td><%= p.receipt_no %></td>
                            <% if (!simpleFeeMode) { %><td>₹<%= p.amount_paid %></td><% } %>
                            <td><%= p.mode %></td>
                            <td><%= p.reference_no || "-" %></td>
                            <td><%= p.remarks || "-" %></td>
                            <td><a href="/reports/receipt/<%= p.id %>" class="btn btn-outline-primary btn-sm" target="_blank"><%= t('fees.receipt_pdf') %></a></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <a href="/fee-payments" class="btn btn-link mt-3"><%= t('fees.back_to_search') %></a>

<% } %>

<%- include("../partials/footer") %>
