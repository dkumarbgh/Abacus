<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>Fees Due Report
    <% if (simpleFeeMode) { %><span class="badge bg-warning text-dark align-middle">Simple Fee Mode: amounts hidden</span><% } %>
</h2>

<form method="GET" action="/reports/fees-due" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="student_name" class="form-control" placeholder="🔍 Search by student name..." value="<%= student_name %>">
    </div>
    <div class="col-md-3">
        <select name="level_id" class="form-select" onchange="this.form.submit()">
            <option value="">All Levels</option>
            <% levels.forEach(l => { %>
                <option value="<%= l.id %>" <%= level_id==l.id ? "selected" : "" %>><%= l.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-3">
        <select name="class_id" class="form-select" onchange="this.form.submit()">
            <option value="">All Standards / Classes</option>
            <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= class_id==c.id ? "selected" : "" %>><%= c.class_name %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-3">
        <select name="branch_id" class="form-select" onchange="this.form.submit()">
            <option value="">All Branches / Centres</option>
            <% branches.forEach(b => { %>
                <option value="<%= b.id %>" <%= branch_id==b.id ? "selected" : "" %>><%= b.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label mb-0"><small class="text-muted">From month</small></label>
        <input type="month" name="from_month" class="form-control" value="<%= from_month %>" onchange="this.form.submit()">
    </div>
    <div class="col-md-3">
        <label class="form-label mb-0"><small class="text-muted">To month</small></label>
        <input type="month" name="to_month" class="form-control" value="<%= to_month %>" onchange="this.form.submit()">
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-primary btn-sm">🔍 Search / Apply Filters</button>
    </div>
    <% if (from_month || to_month || student_name) { %>
        <div class="col-md-3 d-flex align-items-end">
            <% const qs = new URLSearchParams(); if (level_id) qs.set('level_id', level_id); if (class_id) qs.set('class_id', class_id); if (branch_id) qs.set('branch_id', branch_id); const qsStr = qs.toString(); %>
            <a href="/reports/fees-due<%= qsStr ? '?' + qsStr : '' %>" class="btn btn-outline-secondary btn-sm">Clear Search &amp; Month Filter</a>
        </div>
    <% } %>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Student</th><th>Fee</th><th>Due Date</th>
            <% if (!simpleFeeMode) { %><th>Amount Due</th><% } %>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        <% if (rows.length === 0) { %>
            <tr><td colspan="5" class="text-center">No pending dues with due dates found</td></tr>
        <% } %>
        <% rows.forEach(r => { %>
            <tr class="<%= r.overdue ? 'table-danger' : '' %>">
                <td><a href="/reports/student/<%= r.student.id %>"><%= r.student.name %></a></td>
                <td><%= r.fee_name %><%= r.installment_label ? ' - ' + r.installment_label : '' %></td>
                <td><%= r.due_date %></td>
                <% if (!simpleFeeMode) { %><td>₹<%= r.due %></td><% } %>
                <td>
                    <% if (r.overdue) { %>
                        <span class="badge bg-danger">Overdue</span>
                    <% } else { %>
                        <span class="badge bg-warning text-dark">Upcoming</span>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<a href="/reports" class="btn btn-link">&larr; Back to Reports</a>

<%- include("partials/footer") %>
