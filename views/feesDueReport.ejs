<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>Fees Due Report
    <% if (simpleFeeMode) { %><span class="badge bg-warning text-dark align-middle">Simple Fee Mode: amounts hidden</span><% } %>
</h2>

<form method="GET" action="/reports/fees-due" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="class_id" class="form-select" onchange="this.form.submit()">
            <option value="">All Classes</option>
            <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= class_id==c.id ? "selected" : "" %>><%= c.class_name %></option>
            <% }) %>
        </select>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Student</th><th>Fee</th><th>Due Date</th>
            <% if (!simpleFeeMode) { %><th>Amount Due</th><% } %>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        <% if (rows.length === 0) { %>
            <tr><td colspan="5" class="text-center">No pending dues with due dates found</td></tr>
        <% } %>
        <% rows.forEach(r => { %>
            <tr class="<%= r.overdue ? 'table-danger' : '' %>">
                <td><%= r.student.name %></td>
                <td><%= r.fee_name %></td>
                <td><%= r.due_date %></td>
                <% if (!simpleFeeMode) { %><td>₹<%= r.due %></td><% } %>
                <td>
                    <% if (r.overdue) { %>
                        <span class="badge bg-danger">Overdue</span>
                    <% } else { %>
                        <span class="badge bg-warning text-dark">Upcoming</span>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<a href="/reports" class="btn btn-link">&larr; Back to Reports</a>

<%- include("partials/footer") %>
