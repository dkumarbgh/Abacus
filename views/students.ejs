<%- include("partials/header") %>
<%- include("partials/navbar") %>

<h2>Students</h2>

<p>Total Students: <b><%= students.length %></b></p>

<div class="row mb-3">
    <div class="col-md-8">
        <form method="GET" action="/students">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Search Student..." value="<%= search %>">
                <button class="btn btn-primary">🔍 Search</button>
            </div>
        </form>
    </div>
    <div class="col-md-4 text-end">
        <a href="/students/add" class="btn btn-success">➕ Register Student</a>
        <a href="/students/import" class="btn btn-outline-secondary">⬆ Import</a>
        <a href="/students/export" class="btn btn-outline-secondary">⬇ Export</a>
    </div>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Photo</th>
            <th>Name</th>
            <th>Admission No.</th>
            <th>Class</th>
            <th>Guardian Phone</th>
            <th>Face Enrolled</th>
            <th width="320">Action</th>
        </tr>
    </thead>
    <tbody>
        <% students.forEach(function(student){ %>
        <tr>
            <td><%= student.id %></td>
            <td>
                <% if (student.photo_path) { %>
                    <img src="<%= student.photo_path %>" width="40" height="40" style="object-fit:cover" class="rounded-circle border">
                <% } else { %>
                    <span class="text-muted">&mdash;</span>
                <% } %>
            </td>
            <td><%= student.name %></td>
            <td><%= student.admission_no || "-" %></td>
            <td><%= student.class_name || "Not Assigned" %></td>
            <td><%= student.guardian_phone || "-" %></td>
            <td>
                <% if (student.face_enrolled) { %>
                    <span class="badge bg-success">Enrolled</span>
                <% } else { %>
                    <span class="badge bg-secondary">Not Enrolled</span>
                <% } %>
            </td>
            <td>
                <a href="/students/edit/<%= student.id %>" class="btn btn-warning btn-sm">✏ Edit</a>
                <% if (features.faceRecognition) { %>
                    <a href="/students/enroll-face/<%= student.id %>" class="btn btn-info btn-sm">📷 Face</a>
                <% } %>
                <a href="/reports/student/<%= student.id %>" class="btn btn-outline-primary btn-sm">📄 Report</a>
                <a href="/students/delete/<%= student.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Delete this student?')">Delete</a>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include("partials/footer") %>
