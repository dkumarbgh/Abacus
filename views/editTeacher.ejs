<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container mt-4">

<h2>Edit Teacher</h2>

<% if (!teacher) { %>

    <div class="alert alert-danger">Teacher not found.</div>
    <a href="/teachers" class="btn btn-secondary">Back to Teachers</a>

<% } else { %>

<form method="POST" action="/teachers/edit/<%= teacher.id %>">

<div class="mb-3">
    <label>Name</label>
    <input
        type="text"
        name="name"
        class="form-control"
        value="<%= teacher.name %>"
        required>
</div>

<div class="mb-3">
    <label>Subject</label>
    <input
        type="text"
        name="subject"
        class="form-control"
        value="<%= teacher.subject %>"
        required>
</div>

<div class="mb-3">
    <label>Phone</label>
    <input
        type="text"
        name="phone"
        class="form-control"
        value="<%= teacher.phone || '' %>">
</div>

<div class="mb-3">
    <label>Email</label>
    <input
        type="email"
        name="email"
        class="form-control"
        value="<%= teacher.email || '' %>">
</div>

<div class="mb-3">
    <label>Status</label>
    <select name="status" class="form-select">
        <option value="Active" <%= teacher.status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= teacher.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
    </select>
</div>

<button class="btn btn-primary">
    Update Teacher
</button>

<a href="/teachers" class="btn btn-secondary">
    Cancel
</a>

</form>

<% } %>

</div>

<%- include("partials/footer") %>
